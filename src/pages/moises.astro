---
import Layout from "~/layouts/Layout.astro";
import { Image } from "astro:assets";
import moisesLogo from "~/assets/images/logos/moises-logo.svg";
import Pads from "~/components/lab/moises/sampler/Pads.astro";
import DesignComparison from "~/components/lab/moises/DesignComparison.astro";
import AnimatedPipe from "~/components/AnimatedPipe.astro";
import ProductLearningLoop from "~/components/ProductLearningLoop.astro";
import Clients from "~/components/Clients.astro";
import WorkShowcase from "~/components/work/WorkShowcase.astro";
import ContactActions from "~/components/ContactActions.astro";
---

<Layout
  noindex={true}
  title="Giles Butler × Moises — Senior Product Designer"
  description="A story about music, design, engineering and product, and why I want to bring 15+ years of product experience and 25+ years of music production to Moises."
>
  <main>
    <div id="sticky-logo" class="sticky-logo">
      <Image src={moisesLogo} alt="Moises Logo" class="w-20 md:w-24" />

      <span class="block text-slate-300">&vert;</span>

      <a href="/moises" class="logo text-sm shrink-0" aria-label="Giles Butler home">
        Giles Butler<span class="logo-dot">.</span>
      </a>

      <button
        id="section-menu-button"
        class="section-menu-button"
        type="button"
        aria-label="Open section navigation"
        aria-controls="section-drawer"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <dialog
      id="section-drawer"
      class="section-drawer"
      aria-labelledby="section-drawer-title"
    >
      <div class="section-drawer__header">
        <div>
          <h2 id="section-drawer-title">Jump to a chapter</h2>
        </div>
        <button
          class="section-drawer__close"
          type="button"
          aria-label="Close section navigation"
          autofocus
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <nav aria-label="Page sections" class="section-drawer__nav">
        <ol>
          <li>
            <a href="#hero">
              <span>Start</span>
              <span>Introduction</span>
            </a>
          </li>
          <li>
            <a href="#music">
              <span>01</span>
              <span>Music</span>
            </a>
          </li>
          <li>
            <a href="#design">
              <span>02</span>
              <span>Design</span>
            </a>
          </li>
          <li>
            <a href="#engineering">
              <span>03</span>
              <span>Engineering</span>
            </a>
          </li>
          <li>
            <a href="#product">
              <span>04</span>
              <span>Product</span>
            </a>
          </li>
          <li>
            <a href="#ai">
              <span>05</span>
              <span>AI</span>
            </a>
          </li>
          <li>
            <a href="#taste">
              <span>06</span>
              <span>Taste</span>
            </a>
          </li>
          <li>
            <a href="#why">
              <span>07</span>
              <span>Why Moises</span>
            </a>
          </li>
          <li>
            <a href="#work">
              <span>08</span>
              <span>Work</span>
            </a>
          </li>
          <li>
            <a href="#contact">
              <span>End</span>
              <span>Contact</span>
            </a>
          </li>
        </ol>
      </nav>

      <p class="section-drawer__footer">
        Music · Design · Engineering · Product
      </p>
    </dialog>

    <!-- Hero -->
    <section
      id="hero"
      class="theme-section section-full flex-center px-fluid overflow-x-clip"
      data-scroll
      data-scroll-call="heroVisibility"
      data-scroll-repeat
    >
      <p
        class="hand text-2xl md:text-3xl -rotate-3 mb-8 md:mb-12 lg:mb-16 font-bolder self-start"
        data-scroll
        data-scroll-speed="0.5"
      >
        👋 olá 🇧🇷/🇺🇸, this is a <u>story</u> about&hellip;
      </p>

      <h1
        class="display-name selected resizable-heading !text-[#2B2C29]"
        data-resizable-heading
        data-scroll
        data-scroll-speed="0.8"
      >
        <!-- prettier-ignore -->
        <span class="display-name-content"><a class="hover-word hover-word--music" href="#music">Music</a>, <a class="hover-word hover-word--design" href="#design">Design</a>,{""}
          <span class="relative"><a class="hover-word hover-word--engineering" href="#engineering">Engineering</a><span class="hand and">and</span></span>{" "}
          <a class="hover-word hover-word--product" href="#product">Product</a>.</span>
        <span class="h tl" aria-hidden="true"></span>
        <span class="h tr" aria-hidden="true"></span>
        <span class="h bl" aria-hidden="true"></span>
        <span class="h br" aria-hidden="true"></span>
      </h1>

      <p
        class="mono-label text-xs md:text-sm mt-6 !text-slate-400 !lowercase !block"
        data-scroll
        data-scroll-speed="0.6"
      >
        <span class="text-cyan-500">(</span>it's also a job application
        <span class="text-cyan-500">)</span>
      </p>

      <div
        id="hero-logo"
        class="hero-logo max-w-[90%] mx-auto mt-6"
        data-scroll
        data-scroll-css-progress
        data-scroll-position="start,end"
      >
        <div class="flex items-center justify-center">
          <Image src={moisesLogo} alt="Moises Logo" class="w-26 md:w-40 z-2" />

          <span class="block text-slate-300 ml-2 mr-[7px]">&vert;</span>

          <a
            href="/moises"
            class="logo text-lg md:text-xl z-2"
            aria-label="Giles Butler home"
          >
            Giles Butler<span class="logo-dot">.</span>
          </a>
        </div>

        <div
          class="relative mt-6 flex justify-center"
          data-scroll
          data-scroll-speed="0.2"
        >
          <img
            class="avatar flt3 !w-12 z-1 opacity-[calc(0.75-var(--progress))]"
            src="/avatar.jpg"
            alt="Giles' serious artist photo!"
            data-scroll
            data-scroll-css-progress
          />
          <span
            class="hand absolute left-[66%] w-12 rotate-3 !text-slate-500 moody"
            data-scroll-css-progress
          >
            moody artist shot
          </span>
        </div>
      </div>

      <div class="mt-20 text-center space-y-4 z-1">
        <p class="italic text-base md:text-lg text-slate-600">
          So there's one question I've been thinking about&hellip;
        </p>

        <div class="note yellow -rotate-1 !max-w-[280px] md:!max-w-[400px] mx-auto left-0 right-0 !text-amber-950 !relative">
          <p class="text-2xl md:text-3xl hand text-shadow-sm text-shadow-amber-100/70">
            When almost anything can be made quickly, what still takes years to
            learn?
          </p>
        </div>
      </div>
    </section>

    <!-- Music Section -->
    <section id="music" class="theme-section section-full flex-center px-fluid">
      <div
        data-scroll
        data-scroll-css-progress
        class="content-layer flex flex-col items-center opacity-[calc(var(--progress)*2)]"
      >
        <p class="chapter-number">Chapter 1</p>
        <h2 class="display-text" data-scroll data-scroll-position="start,end">
          Music
        </h2>
        <p class="sub-text">Learning to listen.</p>

        <div class="grid md:grid-cols-2 gap-6 mt-12">
          <div class="mx-auto w-full max-w-96 md:w-96 md:max-w-lg lg:w-full lg:max-w-[500px] lg:mt-4 relative">
            <Pads />
            <div class="hand !text-white text-2xl md:text-3xl lg:text-4xl rotate-3 mt-4 text-center tracking-wide">
              go on play my{" "}
              <button
                type="button"
                class="pads-info"
                data-popover-trigger
                aria-controls="handmade-popover"
                aria-expanded="false"
              >
                <u>pads</u>
              </button>{" "}
              - they're hand made
              <div
                id="handmade-popover"
                class="popover pads-popover"
                data-popover
                popover="auto"
                role="status"
              >
                Some things I use AI to create but these I thought would be fun
                to carve out myself using SVG and{" "}
                <a
                  href="https://tonejs.github.io/"
                  target="_blank"
                  class="link"
                >
                  tone.js
                </a>
              </div>
              <span class="block mt-2 text-xl md:text-2xl lg:text-3xl text-slate-400">
                (p.s check you're not muted)
              </span>
            </div>
          </div>

          <div class="prose lg:text-center">
            <p>
              When I was 12 I got into producing and DJing. I learnt something I
              still use every day: making more is easy. Knowing what belongs,
              what doesn't, and when something is finished is much harder.
            </p>

            <p>
              I went on to study Music Production at university, produced with
              Logic in the{" "}
              <a
                href="https://en.wikipedia.org/wiki/Emagic"
                target="_blank"
                class="link-subtle"
              >
                Emagic
              </a>
              era, and used Ableton from Live 4{" "}
              <span class="text-sm italic">
                (and even participated in its beta programme)
              </span>
              . Twenty-five years later, I still produce, release music, collect
              hardware and spend wayyy too much time sampling things.
            </p>

            <div class="note blue max-w-sm text-center !relative rotate-2 mt-12 !text-cyan-900 mx-auto">
              <p class="hand text-2xl md:text-3xl !p-0 !m-0 font-black text-shadow-sm text-shadow-cyan-200/70">
                But instinct only gets you so far. How do you turn a feeling
                into a deliberate decision?
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Design Section -->
    <section
      id="design"
      class="theme-section section-full flex-center px-fluid"
    >
      <div
        data-scroll
        data-scroll-css-progress
        class="content-layer flex flex-col items-center !opacity-[calc(var(--progress)*4)]"
      >
        <p class="chapter-number">Chapter 2</p>
        <h2 class="display-text" data-scroll data-scroll-position="start,end">
          <span class="design-title-text">Design</span>
        </h2>
        <p class="sub-text mb-8">Learning to choose.</p>

        <div class="prose">
          <h4>I started my career as a designer.</h4>
          <p>
            It taught me to turn instinct into intent: to decide what matters,
            where attention should go, and what can disappear without losing
            meaning.
          </p>
          <p>
            Hierarchy. Rhythm. Contrast. Restraint. Not decoration for its own
            sake, but ways of making complex things feel clear and intuitive.
          </p>

          <h4>A lot of design is deciding where complexity should live.</h4>

          <p>
            The same capability can expose every option upfront, or reveal
            complexity only when it becomes useful. Neither is automatically
            right. The job is deciding what someone needs now, what can wait,
            and how much choice helps rather than slows them down.
          </p>

          <p>
            This small example makes that trade-off tangible. Switch between the
            two versions and notice how the capability stays largely the same
            while the number of decisions changes.
          </p>
        </div>

        <DesignComparison />

        <div class="prose mt-8">
          <p>
            Over time, I became less interested in designing screens and more
            interested in designing behaviour: how a product responds, what
            happens between states, and whether an experience still holds
            together when real data, real users and edge cases arrive.
          </p>
        </div>

        <div class="note pink -rotate-2 !max-w-md mx-auto left-0 right-0 text-center !text-pink-950 !relative mt-8">
          <p class="text-2xl md:text-3xl hand text-shadow-sm text-shadow-pink-100/70 !m-0">
            I wanted to design what happened, not just what it looked
            like&hellip;
          </p>
        </div>
      </div>
    </section>

    <!-- Engineering Section -->
    <section
      id="engineering"
      class="theme-section section-full flex-center px-fluid"
    >
      <div class="content-layer space-y-8">
        <p class="chapter-number">Chapter 3</p>
        <h2 class="display-text">Engineering</h2>
        <p class="sub-text">So I learnt to build them.</p>

        <AnimatedPipe />

        <div class="prose lg:text-center">
          <p>
            Frontend soon became full stack. Code stopped being something that
            happened after design and became another material I could design
            with.
          </p>

          <h4 class="!mt-0 mb-8">
            Today, working prototypes are often how I think.
          </h4>

          <p>
            They expose assumptions that static designs hide: state, timing,
            responsiveness, latency, edge cases, animation and what happens when
            real data refuses to fit the happy path.
          </p>

          <h3 class="statement-text !text-[#344760]">
            Sometimes the fastest way to answer a design question is to just
            build it.
          </h3>

          <div class="note blue max-w-sm text-center !relative rotate-1 mt-12 !text-cyan-900 mx-auto">
            <p class="hand text-3xl !p-0 !m-0 font-black text-shadow-sm text-shadow-cyan-200/70">
              Building taught me that the interface is only one part of the
              product though&hellip;
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Section -->
    <section
      id="product"
      class="theme-section section-full flex-center px-fluid text-shadow-sm text-shadow-amber-200/50"
    >
      <div
        class="content-layer space-y-8 !opacity-[calc(var(--progress)*3)]"
        data-scroll
        data-scroll-css-progress
      >
        <p class="chapter-number">Chapter 4</p>
        <h2 class="display-text">Product</h2>
        <p class="sub-text">Then I learnt to think beyond the interface.</p>

        <div class="prose">
          <p>
            The last decade has been spent building products inside startups.
          </p>

          <p>
            Talking to customers. Shipping before everything is known. Watching
            where people get stuck. Changing direction when reality disagrees
            with the plan. Building systems that survive as both the product and
            the team grow.
          </p>

          <h3>Good product work moves at the speed of learning.</h3>

          <p>Speed matters, but not everywhere equally.</p>

          <p>
            Some decisions deserve days of craft. Some need another customer
            conversation. Some need a prototype in an afternoon. Some simply
            need shipping.
          </p>

          <p>
            The skill is knowing what needs more thinking, and what needs
            putting in front of people.
          </p>
        </div>

        <ProductLearningLoop />

        <div class="note green -rotate-2 !max-w-md ml-auto w-80 text-center !text-green-900 !relative">
          <p class="text-2xl md:text-3xl hand text-shadow-sm text-shadow-green-100/70 !m-0">
            Then suddenly the whole loop got much faster&hellip;
          </p>
        </div>
      </div>
    </section>

    <!-- AI Section -->
    <section id="ai" class="theme-section section-full flex-center px-fluid">
      <div class="content-layer space-y-8" data-scroll data-scroll-css-progress>
        <p class="chapter-number">Chapter 5</p>
        <h2 class="display-text">THE TOOLS CHANGED.</h2>
        <p class="sub-text">The bottleneck moved.</p>

        <div class="prose">
          <p>
            AI has radically shortened the distance between an idea and
            something tangible.
          </p>

          <p>
            I can explore more directions, build more prototypes and test more
            assumptions in a day than I could have in weeks earlier in my
            career.
          </p>

          <h3 class="statement-text">
            When options become abundant, judgement becomes scarce.
          </h3>

          <p class="hand text-3xl md:text-4xl lg:text-5xl mt-4 text-right text-accent -rotate-2">
            So what still takes years to learn?
          </p>
        </div>
      </div>
    </section>

    <!-- Taste Section -->
    <section id="taste" class="theme-section section-full flex-center px-fluid">
      <div class="content-layer space-y-8" data-scroll data-scroll-css-progress>
        <p class="chapter-number">Chapter 6</p>
        <h2 class="display-text text-accent !mb-8">TASTE</h2>

        <div class="prose">
          <p>Not aesthetic preference.</p>

          <p><strong>Accumulated judgement.</strong></p>

          <!-- <figure>
            <blockquote
              cite="https://paulgraham.com/taste.html"
              class="text-blue-400"
            >
              <p>We need good taste to make good things.</p>
              <figcaption class="text-blue-400">
                —{" "}
                <cite>
                  Paul Graham -{" "}
                  <a
                    href="https://paulgraham.com/taste.html"
                    target="_blank"
                    class="link-subtle"
                  >
                    Taste For Makers
                  </a>
                </cite>
              </figcaption>
            </blockquote>
          </figure> -->

          <p>
            It's the pattern recognition that comes from making things, getting
            things wrong, seeing what survives contact with reality and
            developing a clearer sense of what deserves to exist in the first
            place.
          </p>

          <figure>
            <blockquote
              cite="https://www.workingtheorys.com/p/taste-is-eating-silicon-valley"
              class="text-blue-400"
            >
              <p>
                In a world of scarcity, we treasure tools. In a world of
                abundance, we treasure taste.
              </p>
              <figcaption class="text-blue-400">
                <cite>
                  Anu Atluru -
                  <a
                    href="https://www.workingtheorys.com/p/taste-is-eating-silicon-valley"
                    target="_blank"
                    class="link-subtle"
                  >
                    Taste is Eating Silicon Valley
                  </a>
                </cite>
              </figcaption>
            </blockquote>
          </figure>

          <div class="note yellow -rotate-1 max-w-md mx-auto left-0 right-0 text-center !text-amber-950">
            <p class="text-2xl md:text-3xl hand text-shadow-sm text-shadow-amber-100/70 !m-0">
              Which brings us back to where we started&hellip;
            </p>
          </div>
        </div>
      </div>

      <p
        class="bg-text"
        data-scroll
        data-scroll-speed="1.5"
        data-scroll-position="start,end"
      >
        TASTE
      </p>
    </section>

    <!-- Why Section -->
    <section
      id="why"
      class="theme-section section-full flex-center px-fluid border-y border-slate-200"
    >
      <div
        class="content-layer space-y-8 !opacity-[calc(var(--progress)*3)] text-shadow-sm text-shadow-white"
        data-scroll
        data-scroll-css-progress
      >
        <p class="chapter-number">Chapter 7</p>
        <h2 class="display-name">
          <!-- prettier-ignore -->
          <span class="display-name-content">
            <span>Music<span class="text-cyan-500">.</span>
              <p class="why-text">Taught me to listen. To notice what others might miss.</p>
            </span>
            <span>Design<span class="text-cyan-500">.</span>
              <p class="why-text">To choose. To decide what matters and remove what doesn't.</p>
            </span>
            <span>
              Engineering<span class="text-cyan-500">.</span>
              <p class="why-text">To build. To create. To solve problems. To turn an idea into something real.</p>
            </span>
            <span>Product<span class="text-cyan-500">.</span>
              <p class="why-text">To challenge assumptions. To let customers and reality have the final word.</p>
            </span>
          </span>
        </h2>

        <div class="relative">
          <div class="xl:max-w-80 xl:text-center xl:absolute xl:right-[45px] xl:top-[-144px]">
            <h2 class="hand text-3xl md:text-4xl xl:text-4xl xl:text-5xl text-[var(--theme-accent)] -rotate-2 xl:-rotate-5 text-shadow-sm text-shadow-red-100/70">
              Twenty-five years of making things has shaped how I make decisions
              today!
            </h2>
          </div>
        </div>

        <div class="prose">
          <p>Most jobs use one or two parts of my background.</p>

          <p>
            The Senior Product Designer{" "}
            <a
              href="https://moises.bamboohr.com/careers/75"
              class="!underline !decoration-dashed hover:!no-underline"
              target="_blank"
              title="Senior Product Designer"
            >
              role
            </a>{" "}
            at{" "}
            <Image
              src={moisesLogo}
              alt="Moises Logo"
              class="w-24 inline !m-0 -rotate-1"
            />{" "}
            sits directly across all of them.
          </p>

          <p>
            I already understand what it feels like to spend hours inside a DAW.
            I have spent my career designing and building complex software. I
            work directly in code. I understand startup product development from
            the inside. And I am already using AI to radically shorten the
            distance between an idea and something I can test.
          </p>

          <p>
            I would not be learning the domain so I could design for it&hellip;
          </p>

          <h3 class="mt-0">It is already part of how I think and work.</h3>

          <p class="mono-label text-sm md:text-base lg:text-lg -mt-2 !text-slate-500 !lowercase !block">
            <span class="text-cyan-500">(</span>and I'd like to help shape what
            comes next<span class="text-cyan-500">)</span>
          </p>
        </div>
      </div>

      <div class="note yellow -rotate-1 max-w-md mt-6 mx-auto left-0 right-0 text-center !text-amber-950 !relative">
        <p class="text-2xl md:text-3xl hand text-shadow-sm text-shadow-amber-100/70 !m-0">
          Two products probably explain this better than I can&hellip;
        </p>
      </div>
    </section>

    <!-- Work Section -->
    <section id="work" class="theme-section section-full flex-center px-fluid">
      <div class="content-layer" data-scroll data-scroll-css-progress>
        <p class="chapter-number">Chapter 8</p>
        <h2 class="display-text">Work</h2>
        <p class="sub-text">From first idea to everyday use.</p>

        <div class="prose my-8 text-center !text-slate-600">
          <p>
            An AI product built for scale. A desktop app built for the studio.
          </p>
          <p>
            Two places where design, engineering and product became the same
            job.
          </p>
        </div>
      </div>

      <WorkShowcase />

      <Clients label="teams and products I've worked on" />
    </section>

    <!-- Contact Section -->
    <section
      id="contact"
      class="theme-section section-full flex-center px-fluid"
    >
      <div class="content-layer" data-scroll data-scroll-css-progress>
        <p class="chapter-number">The next chapter?</p>
        <h2 class="display-text text-accent">Say Hello</h2>
        <div class="prose my-8 text-center">
          <p>
            I've spent years making music, designing products and building
            software.
          </p>
          <p>I'd like to bring all of it to Moises.</p>
          <p>
            I'm UK based and have been working remotely for over 10 years.
            Comfortable with Brazil and US overlap, including later hours where
            useful.
          </p>
        </div>
        <ContactActions />
      </div>

      <p class="text-center text-sm text-cyan-200 mt-20 italic">
        Site designed and built for this application 👋
      </p>
    </section>
  </main>
</Layout>

<script>
  import LocomotiveScroll from "locomotive-scroll";
  import { setupPopovers } from "~/scripts/popover";
  import { setupResizableSelections } from "~/scripts/resizable-selection";

  const hero = document.querySelector("#hero");
  const stickyLogo = document.querySelector("#sticky-logo");
  const designTitle = document.querySelector(".design-title-text");

  function setupSectionDrawer() {
    const menuButton = document.querySelector<HTMLButtonElement>(
      "#section-menu-button",
    );
    const drawer = document.querySelector<HTMLDialogElement>("#section-drawer");

    if (!menuButton || !drawer) return;

    menuButton.addEventListener("click", () => {
      drawer.showModal();
      menuButton.setAttribute("aria-expanded", "true");
    });

    drawer.addEventListener("close", () => {
      menuButton.setAttribute("aria-expanded", "false");
    });

    drawer.addEventListener("click", (event) => {
      if (event.target === drawer) drawer.close();
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => drawer.close());
    });

    drawer
      .querySelector(".section-drawer__close")
      ?.addEventListener("click", () => drawer.close());
  }

  function setupDesignPointerEffect() {
    if (!(designTitle instanceof HTMLElement)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let pointerPosition: { x: number; y: number } | null = null;
    let frame: number | null = null;

    const updateDesignTitle = () => {
      frame = null;
      if (!pointerPosition) return;

      const x = (pointerPosition.x / window.innerWidth) * 2 - 1;
      const y = (pointerPosition.y / window.innerHeight) * 2 - 1;
      const titleBounds = designTitle.getBoundingClientRect();
      const titleCenterX = titleBounds.left + titleBounds.width / 2;
      const titleCenterY = titleBounds.top + titleBounds.height / 2;
      const distanceFromTitle = Math.hypot(
        pointerPosition.x - titleCenterX,
        pointerPosition.y - titleCenterY,
      );
      const fadeDistance =
        Math.max(window.innerWidth, window.innerHeight) * 0.7;
      const registerOpacity = Math.max(0, 1 - distanceFromTitle / fadeDistance);

      designTitle.style.setProperty("--design-shift-x", `${-x * 0.025}em`);
      designTitle.style.setProperty("--design-shift-y", `${-y * 0.015}em`);
      designTitle.style.setProperty("--design-cyan-x", `${x * 0.05}em`);
      designTitle.style.setProperty("--design-cyan-y", `${y * 0.25}em`);
      designTitle.style.setProperty("--design-magenta-x", `${-x * 0.03}em`);
      designTitle.style.setProperty("--design-magenta-y", `${-y * 0.18}em`);
      designTitle.style.setProperty(
        "--design-register-opacity",
        String(registerOpacity),
      );
    };

    window.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType !== "mouse") return;

        pointerPosition = { x: event.clientX, y: event.clientY };
        if (frame === null) frame = requestAnimationFrame(updateDesignTitle);
      },
      { passive: true },
    );
  }

  function syncStickyLogo() {
    if (!(hero instanceof HTMLElement)) return;
    if (!(stickyLogo instanceof HTMLElement)) return;

    const heroHasPassed = hero.getBoundingClientRect().bottom <= 0;

    stickyLogo.classList.toggle("is-visible", heroHasPassed);
  }

  window.addEventListener("heroVisibility", (event) => {
    if (!(event instanceof CustomEvent)) return;
    if (!(stickyLogo instanceof HTMLElement)) return;

    const { way } = event.detail;

    if (way === "enter") {
      stickyLogo.classList.remove("is-visible");
    }

    if (way === "leave") {
      stickyLogo.classList.add("is-visible");
    }
  });

  const locomotiveScroll = new LocomotiveScroll();

  window.addEventListener("work-showcase-layout-change", () => {
    requestAnimationFrame(() => locomotiveScroll.resize());
  });

  setupSectionDrawer();
  setupDesignPointerEffect();
  setupPopovers();
  setupResizableSelections();

  // Correct state if the browser loads/restores further down the page.
  requestAnimationFrame(syncStickyLogo);

  // Also handle refresh/back-forward cache restoration.
  window.addEventListener("pageshow", () => {
    requestAnimationFrame(syncStickyLogo);
  });
</script>

