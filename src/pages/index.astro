---
import Layout from "~/layouts/Layout.astro";
import Nav from "~/components/Nav.astro";
import Hero from "~/components/Hero.astro";
import Clients from "~/components/Clients.astro";
import Statement from "~/components/Statement.astro";
import About from "~/components/About.astro";
import Stats from "~/components/Stats.astro";
import FeaturedWorks from "~/components/FeaturedWorks.astro";
import Testimonials from "~/components/Testimonials.astro";
import Contact from "~/components/Contact.astro";
import Footer from "~/components/Footer.astro";
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <Clients />
    <Statement />
    <div class="arc" aria-hidden="true">
      <svg viewBox="0 0 1200 90" fill="none" preserveAspectRatio="none"
        ><path d="M0 80 Q600 0 1200 80" stroke="currentColor" stroke-width="2"></path></svg
      >
    </div>
    <About />
    <Stats />
    <FeaturedWorks />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</Layout>
