---
import Layout from "~/layouts/Layout.astro";
import Nav from "~/components/Nav.astro";
import PageHeader from "~/components/PageHeader.astro";
import WorkGrid from "~/components/WorkGrid.astro";
import Testimonials from "~/components/Testimonials.astro";
import Contact from "~/components/Contact.astro";
import Footer from "~/components/Footer.astro";
import { siteConfig } from "~/config/site";

const h = siteConfig.pages.work;
---

<Layout title={`Work — ${siteConfig.name}`} description={h.subtitle}>
  <Nav />
  <main id="main">
    <PageHeader kicker={h.kicker} title={h.title} subtitle={h.subtitle} />
    <section class="section"><WorkGrid /></section>
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</Layout>
