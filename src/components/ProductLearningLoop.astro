---
interface Props {
  autoplay?: boolean;
  noOutro?: boolean;
}

const { autoplay = true, noOutro = true } = Astro.props;
---

<product-learning-loop
  autoplay={autoplay}
  no-outro={noOutro}
  class="text-shadow-none"
>
  <noscript>
    <p class="pl-noscript">
      The product learning loop is an interactive illustration of how small
      prototypes, real use, feedback, and safer alternatives shape what gets
      built next.
    </p>
  </noscript>
</product-learning-loop>

<style is:global>
  product-learning-loop {
    --loop-ink: #262721;
    --loop-surface: #252620;
    --loop-panel: #30312a;
    --loop-paper: #f3efdf;
    --loop-muted: #babbae;
    --loop-accent: #f5be44;
    --loop-mint: #c9ffdc;
    --loop-font: var(--font-body, inherit);
    --loop-mono: var(
      --font-mono,
      ui-monospace,
      SFMono-Regular,
      Consolas,
      "Liberation Mono",
      monospace
    );
    display: block;
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    color: var(--loop-paper);
    font-family: var(--loop-font);
    -webkit-font-smoothing: antialiased;
    isolation: isolate;
  }

  product-learning-loop *,
  product-learning-loop *::before,
  product-learning-loop *::after {
    box-sizing: border-box;
  }

  product-learning-loop [hidden] {
    display: none !important;
  }

  product-learning-loop button,
  product-learning-loop a {
    -webkit-tap-highlight-color: transparent;
  }

  product-learning-loop button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }

  product-learning-loop button:focus-visible,
  product-learning-loop a:focus-visible,
  product-learning-loop [tabindex="0"]:focus-visible {
    outline: 3px solid var(--loop-mint);
    outline-offset: 5px;
  }

  product-learning-loop svg {
    display: block;
  }

  product-learning-loop .pl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  product-learning-loop .pl-noscript {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--loop-ink);
    color: var(--loop-ink);
  }

  product-learning-loop .pl-machine {
    position: relative;
    padding: clamp(20px, 3.7vw, 36px);
    border: 1px solid #44453b;
    border-radius: 26px;
    background: linear-gradient(
      135deg,
      #303129 0%,
      var(--loop-surface) 38%,
      #22231e 100%
    );
    box-shadow:
      0 3px 0 #1d1e18,
      0 10px 0 -5px #b5802740,
      0 22px 45px -22px #392a2770,
      inset 0 1px 0 #ffffff10;
  }

  product-learning-loop .pl-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  product-learning-loop .pl-label,
  product-learning-loop .pl-counter,
  product-learning-loop .pl-eyebrow,
  product-learning-loop .pl-caption,
  product-learning-loop .pl-footer-note {
    font-family: var(--loop-mono);
    font-size: 12px;
    letter-spacing: 0.095em;
    font-weight: 500;
    line-height: 1.5;
  }

  product-learning-loop .pl-label {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--loop-muted);
  }

  product-learning-loop .pl-power-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--loop-mint);
    box-shadow: 0 0 0 4px #c9ffdc09;
  }

  product-learning-loop .pl-counter {
    color: var(--loop-muted);
  }

  product-learning-loop .pl-counter strong {
    color: var(--loop-paper);
    font-weight: 500;
  }

  /* The HTML buttons and SVG use the same four 25% columns. */
  product-learning-loop .pl-route {
    position: relative;
    margin-inline: -10px;
  }

  product-learning-loop .pl-wiring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 148px;
    overflow: visible;
  }

  product-learning-loop .pl-wire {
    fill: none;
    stroke: #5f6051;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  product-learning-loop .pl-wire-arrow {
    fill: none;
    stroke: #858675;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  product-learning-loop .pl-wire-active {
    fill: none;
    stroke: var(--loop-accent);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  product-learning-loop .pl-signal {
    fill: var(--loop-accent);
  }

  product-learning-loop .pl-signal-halo {
    fill: var(--loop-accent);
    opacity: 0.13;
  }

  product-learning-loop .pl-tabs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-top: 8px;
  }

  product-learning-loop .pl-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 116px;
    height: 89px;
    max-width: calc(100% - 12px);
    justify-self: center;
    border: 1px solid #525448;
    border-radius: 13px;
    background: linear-gradient(160deg, #44463b, #32342b);
    color: #d6d6c8;
    box-shadow:
      inset 0 1px 0 #ffffff0d,
      0 4px 0 #151610,
      0 6px 7px #00000025;
    transform: translateY(0);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  product-learning-loop .pl-step-icon {
    width: 25px;
    height: 25px;
  }

  product-learning-loop .pl-step-text {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }

  product-learning-loop .pl-step[aria-selected="true"] {
    color: var(--loop-ink);
    border-color: #ffe6a4;
    background: linear-gradient(155deg, #ffdc87, var(--loop-accent));
    box-shadow:
      inset 0 1px 0 #fff6d899,
      0 2px 0 #966c1f,
      0 6px 18px #f5be4414;
    transform: translateY(3px);
  }

  @media (hover: hover) {
    product-learning-loop .pl-step:hover:not([aria-selected="true"]) {
      color: #fff;
      border-color: #8e917a;
      transform: translateY(-2px);
    }

    product-learning-loop .pl-control:hover {
      background: #ffffff0c;
      border-color: #787a68;
    }
  }

  product-learning-loop .pl-loop-label {
    position: relative;
    z-index: 1;
    width: max-content;
    max-width: 70%;
    margin: 32px auto 26px;
    padding: 0 12px;
    background: var(--loop-surface);
    color: #b9bba8;
    font: 11px/18px var(--loop-mono);
    letter-spacing: 0.12em;
    text-align: center;
  }

  product-learning-loop .pl-panels {
    position: relative;
  }

  product-learning-loop .pl-panel {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: 36px;
    min-height: 275px;
  }

  product-learning-loop .pl-panel.pl-enter {
    animation: pl-enter 0.32s cubic-bezier(0.2, 0.65, 0.3, 1) both;
  }

  @keyframes pl-enter {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  product-learning-loop .pl-eyebrow {
    margin: 0 0 15px;
    color: var(--loop-accent);
    font-size: 10px;
  }

  product-learning-loop .pl-heading {
    max-width: 11em;
    margin: 0 0 15px;
    color: var(--loop-paper);
    font-family: var(--loop-font);
    font-size: clamp(25px, 3.5vw, 38px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.09;
  }

  product-learning-loop .pl-description {
    max-width: 30em;
    margin: 0;
    color: #c8c9bb;
    font-size: 14px;
    line-height: 1.6;
  }

  product-learning-loop .pl-question {
    margin-top: 23px;
    padding-left: 12px;
    border-left: 2px solid #686b56;
    color: #e6e6d7;
    font-size: 13px;
    line-height: 1.5;
  }

  product-learning-loop .pl-question small {
    display: block;
    margin-bottom: 4px;
    color: #b4b7a3;
    font: 13px/1.4 var(--loop-mono);
    letter-spacing: 0.07em;
  }

  /* Mini product artefacts. The example is deliberately fictional. */
  product-learning-loop .pl-artefact {
    min-width: 0;
  }

  product-learning-loop .pl-browser {
    overflow: hidden;
    border: 1px solid #fcf9ec;
    border-radius: 11px;
    background: var(--loop-paper);
    color: var(--loop-ink);
    box-shadow: 0 10px 25px -15px #00000099;
  }

  product-learning-loop .pl-browser-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 13px;
    border-bottom: 1px solid #d7d4c7;
    background: #e8e5d9;
    color: #5a5d50;
    font: 9px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-window-dots {
    display: flex;
    gap: 4px;
  }

  product-learning-loop .pl-window-dots i {
    width: 5px;
    height: 5px;
    border: 1px solid #989c88;
    border-radius: 50%;
  }

  product-learning-loop .pl-site {
    padding: 19px 19px 17px;
  }

  product-learning-loop .pl-site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  product-learning-loop .pl-site-brand {
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.07em;
  }

  product-learning-loop .pl-site-nav span:last-child {
    color: #666a5b;
    font: 8px/1 var(--loop-mono);
  }

  product-learning-loop .pl-site-body {
    display: grid;
    grid-template-columns: 1fr 78px;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
  }

  product-learning-loop .pl-site-title {
    margin: 0;
    font-size: 25px;
    font-weight: 850;
    letter-spacing: -0.05em;
    line-height: 0.99;
  }

  product-learning-loop .pl-site-lines {
    margin-top: 10px;
  }

  product-learning-loop .pl-site-lines i {
    display: block;
    width: 90%;
    height: 3px;
    margin: 5px 0;
    border-radius: 5px;
    background: #c7c9b8;
  }

  product-learning-loop .pl-site-lines i:last-child {
    width: 64%;
  }

  product-learning-loop .pl-art {
    width: 76px;
    height: 76px;
  }

  product-learning-loop .pl-mock-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
    padding: 9px 12px;
    border-radius: 6px;
    background: var(--loop-ink);
    color: var(--loop-paper);
    font-size: 10px;
    font-weight: 600;
  }

  product-learning-loop .pl-caption {
    margin-top: 11px;
    color: #b5b8a4;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
  }

  product-learning-loop .pl-live-strip {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    background: #d5f1db;
    color: #294c35;
    font: 9px/1.5 var(--loop-mono);
  }

  product-learning-loop .pl-live-strip::before {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #427f58;
    content: "";
  }

  product-learning-loop .pl-listen-card {
    padding: 19px;
    border: 1px solid #5a5d4a;
    border-radius: 11px;
    background: #35372d;
  }

  product-learning-loop .pl-feedback-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 15px;
    color: #c8cab8;
    font: 9px/1.4 var(--loop-mono);
    letter-spacing: 0.06em;
  }

  product-learning-loop .pl-quote {
    margin: 0 0 10px;
    padding: 13px 14px;
    border-radius: 8px 8px 8px 2px;
    background: #f9e2ec;
    color: #42323d;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: 0 3px 0 #00000012;
  }

  product-learning-loop .pl-quote:nth-of-type(2) {
    margin-left: 20px;
    background: #ecebdd;
    color: #34392e;
  }

  product-learning-loop .pl-observation {
    margin: 17px 0 0;
    padding-left: 9px;
    border-left: 2px solid var(--loop-accent);
    color: #dbdfc9;
    font-size: 11px;
    line-height: 1.5;
  }

  product-learning-loop .pl-versions {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    background: #e1e7d7;
  }

  product-learning-loop .pl-version-chip {
    color: #526044;
    font: 9px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-version-current {
    margin-left: auto;
    padding: 3px 7px;
    border: 1px solid #bfc9b0;
    border-radius: 4px;
    background: #f4f6ec;
    font: 9px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-try {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 100%;
    min-height: 38px;
    margin-top: 15px;
    padding: 8px 12px;
    border: 1px solid #22261b;
    border-radius: 6px;
    background: var(--loop-ink);
    color: var(--loop-paper);
    font-size: 11px;
    font-weight: 650;
  }

  product-learning-loop .pl-try:focus-visible,
  product-learning-loop .pl-restore:focus-visible {
    outline-color: #294fc2;
    outline-offset: 2px;
  }

  product-learning-loop .pl-restore {
    padding: 2px 0;
    border: 0;
    border-bottom: 1px solid #69805d;
    background: transparent;
    color: #435b35;
    font: 9px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-learn-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 23px;
    margin-top: 9px;
    color: #546648;
    font: 9px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-learn-status span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  product-learning-loop .pl-learn-site {
    padding-bottom: 10px;
  }

  product-learning-loop .pl-learn-site .pl-site-body {
    grid-template-columns: 1fr 62px;
    margin-top: 13px;
  }

  product-learning-loop .pl-learn-site .pl-site-title {
    font-size: 23px;
  }

  product-learning-loop .pl-learn-site .pl-art {
    width: 62px;
    height: 62px;
  }

  /* A transport, not an endless autoplay decoration. */
  product-learning-loop .pl-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 27px;
    padding-top: 17px;
    border-top: 1px solid #4c4e41;
  }

  product-learning-loop .pl-pace {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  product-learning-loop .pl-pace-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 17px;
  }

  product-learning-loop .pl-pace-bars i {
    width: 3px;
    border-radius: 1px;
    background: #626651;
  }

  product-learning-loop .pl-pace-bars i:nth-child(1) {
    height: 7px;
  }

  product-learning-loop .pl-pace-bars i:nth-child(2) {
    height: 12px;
  }

  product-learning-loop .pl-pace-bars i:nth-child(3) {
    height: 17px;
  }

  product-learning-loop .pl-pace-bars i.pl-lit {
    background: var(--loop-accent);
  }

  product-learning-loop .pl-pace-text {
    color: #c7cbb7;
    font: 13px/1.4 var(--loop-mono);
  }

  product-learning-loop .pl-controls {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  product-learning-loop .pl-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 42px;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid #5c5e50;
    border-radius: 7px;
    background: transparent;
    color: #eeeedf;
    font-size: 11px;
    font-weight: 500;
    transition:
      background-color 0.18s,
      border-color 0.18s;
  }

  product-learning-loop .pl-control.pl-replay {
    padding-inline: 10px;
  }

  product-learning-loop .pl-track-progress {
    height: 2px;
    margin-top: 16px;
    overflow: hidden;
    border-radius: 5px;
    background: #494d3b;
  }

  product-learning-loop .pl-track-progress span {
    display: block;
    height: 100%;
    background: var(--loop-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  product-learning-loop .pl-below {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-top: 17px;
    color: var(--ink, var(--loop-ink));
  }

  product-learning-loop .pl-footer-note {
    max-width: 41em;
    margin: 0 auto;
    font-size: 13px;
    letter-spacing: 0.015em;
    opacity: 0.86;
    text-align: center;
  }

  product-learning-loop .pl-outro-slot {
    display: flex;
    justify-content: flex-end;
    min-height: 100px;
    margin-top: 18px;
  }

  product-learning-loop .pl-outro {
    align-self: start;
    max-width: 350px;
    margin: 0 7px 0 0;
    padding: 15px 25px;
    border-radius: 3px;
    background: var(--loop-mint);
    color: #234b32;
    font-family: var(--font-hand, cursive);
    font-size: 21px;
    line-height: 1.3;
    text-align: center;
    box-shadow: 0 9px 16px -11px #38401888;
    transform: translateY(8px) rotate(-1.8deg);
    opacity: 0;
    transition:
      transform 0.55s cubic-bezier(0.2, 0.75, 0.25, 1),
      opacity 0.4s;
  }

  product-learning-loop[data-complete="true"] .pl-outro,
  product-learning-loop[data-reduced-motion="true"] .pl-outro {
    opacity: 1;
    transform: translateY(0) rotate(-1.8deg);
  }

  product-learning-loop[no-outro] .pl-outro-slot {
    display: none;
  }

  product-learning-loop[data-paused="true"] .pl-power-dot {
    background: #b7b9a6;
    box-shadow: none;
  }

  product-learning-loop[data-complete="true"] .pl-power-dot {
    background: var(--loop-mint);
  }

  product-learning-loop[data-complete="true"] .pl-track-progress span {
    background: var(--loop-mint);
  }

  @media (max-width: 640px) {
    product-learning-loop .pl-machine {
      padding: 21px 18px;
      border-radius: 20px;
    }

    product-learning-loop .pl-topbar {
      gap: 7px;
      margin-bottom: 14px;
    }

    product-learning-loop .pl-label,
    product-learning-loop .pl-counter {
      font-size: 8px;
      letter-spacing: 0.04em;
    }

    product-learning-loop .pl-step {
      width: 77px;
      height: 78px;
      max-width: calc(100% - 8px);
      gap: 7px;
      border-radius: 10px;
    }

    product-learning-loop .pl-step-text {
      font-size: 9px;
      letter-spacing: 0.07em;
    }

    product-learning-loop .pl-step-icon {
      width: 23px;
      height: 23px;
    }

    product-learning-loop .pl-wiring {
      height: 137px;
    }

    product-learning-loop .pl-loop-label {
      max-width: 70%;
      margin-top: 32px;
      margin-bottom: 20px;
      padding-inline: 7px;
      font-size: 7px;
      letter-spacing: 0.06em;
    }

    product-learning-loop .pl-panel {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 21px;
      min-height: 512px;
    }

    product-learning-loop .pl-heading {
      max-width: 12em;
      margin-bottom: 11px;
      font-size: 30px;
    }

    product-learning-loop .pl-eyebrow {
      margin-bottom: 10px;
      font-size: 9px;
    }

    product-learning-loop .pl-description {
      font-size: 13px;
    }

    product-learning-loop .pl-question {
      margin-top: 14px;
      font-size: 11px;
    }

    product-learning-loop .pl-copy {
      min-height: 202px;
    }

    product-learning-loop .pl-artefact {
      width: 100%;
      max-width: 380px;
      margin-inline: auto;
    }

    product-learning-loop .pl-site-body {
      grid-template-columns: 1fr 67px;
    }

    product-learning-loop .pl-site-title {
      font-size: 26px;
    }

    product-learning-loop .pl-art {
      width: 65px;
      height: 65px;
    }

    product-learning-loop .pl-listen-card {
      min-height: 230px;
    }

    product-learning-loop .pl-footer {
      margin-top: 22px;
    }

    product-learning-loop .pl-pace-text {
      font-size: 9px;
    }

    product-learning-loop .pl-control {
      min-height: 42px;
    }

    product-learning-loop .pl-below {
      flex-direction: column;
      gap: 9px;
      margin-top: 14px;
    }

    product-learning-loop .pl-footer-note {
      font-size: 9px;
    }

    product-learning-loop .pl-outro-slot {
      min-height: 94px;
    }

    product-learning-loop .pl-outro {
      max-width: 300px;
      font-size: 20px;
    }
  }

  @media (max-width: 370px) {
