</style>

<script>
  // The custom element intentionally uses dynamic DOM handles, like the original standalone JS.
  // @ts-nocheck
  (() => {
    "use strict";

    if (
      typeof window === "undefined" ||
      !window.customElements ||
      customElements.get("product-learning-loop")
    ) {
      return;
    }

    const NAMES = ["Build", "Ship", "Listen", "Learn"];
    const DEFAULT_DURATIONS = [4600, 1800, 900];
    let instanceCount = 0;

    const paths = {
      build:
        '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M17.5 14v7m-3.5-3.5h7"/>',
      ship: '<path d="M12 15V3m-4 4 4-4 4 4M5 12H3v8a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-8h-2"/><path d="M3 15h5l2 3h4l2-3h5"/>',
      listen:
        '<path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-3 2 1.7-5.7A8.5 8.5 0 1 1 21 11.5Z"/><path d="M7 10v3m4-5v7m4-5v3"/>',
      learn:
        '<path d="M9 17h6m-5 4h4M8.5 14.5a6 6 0 1 1 7 0L15 17H9zM12 1v1M2 7l2 1m16 0 2-1"/>',
      pause: '<path d="M8 5v14M16 5v14"/>',
      play: '<path d="m8 5 11 7-11 7V5Z"/>',
      replay: '<path d="M3 10a9 9 0 1 1 .6 7M3 3v7h7"/>',
      arrow: '<path d="M4 12h16m-6-6 6 6-6 6"/>',
      check: '<path d="m5 12 4 4L19 6"/>',
      sparkle:
        '<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"/>',
      undo: '<path d="m9 4-5 5 5 5M4 9h10a6 6 0 0 1 0 12" />',
    };

    function icon(name, size = 18, className = "") {
      return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="${className}">${paths[name] || ""}</svg>`;
    }

    function art() {
      return `<svg class="pl-art" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <rect width="96" height="96" rx="48" fill="#cdabed"/>
        <g fill="none" stroke="#473257" stroke-width="1.2" opacity=".82">
          <ellipse cx="48" cy="48" rx="29" ry="37"/><ellipse cx="48" cy="48" rx="18" ry="37"/>
          <ellipse cx="48" cy="48" rx="7" ry="37"/><path d="M15 34h66M11 48h74M15 62h66"/>
        </g><circle cx="72" cy="21" r="8" fill="#f6d576"/></svg>`;
    }

    function site(learn = false) {
      return `<div class="pl-site ${learn ? "pl-learn-site" : ""}">
        <div class="pl-site-nav"><span class="pl-site-brand">RHYTHM ROOM</span><span>ABOUT / CONTACT</span></div>
        <div class="pl-site-body"><div><p class="pl-site-title" ${learn ? "data-draft-title" : ""}>A home for<br>late-night ideas.</p>
        <div class="pl-site-lines" aria-hidden="true"><i></i><i></i></div></div>${art()}</div>
        ${
          learn
            ? `<button class="pl-try" type="button" data-try>${icon("sparkle", 13)}Try another version</button>
        <div class="pl-learn-status"><span>${icon("check", 12)}Original saved</span><button type="button" class="pl-restore" data-restore>Restore original</button></div>`
            : `<div class="pl-mock-action">Try another version ${icon("arrow", 12)}</div>`
        }
      </div>`;
    }

    const browserTop = `<div class="pl-browser-top"><span class="pl-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>website / first draft</span>${icon("sparkle", 11)}</div>`;

    function template(id) {
      const tabs = NAMES.map(
        (name, i) =>
          `<button type="button" class="pl-step" role="tab" id="${id}-tab-${i}" aria-controls="${id}-panel-${i}" aria-selected="${i === 0}" tabindex="${i === 0 ? 0 : -1}" data-stage="${i}">${icon(name.toLowerCase(), 25, "pl-step-icon")}<span class="pl-step-text">${name.toUpperCase()}</span></button>`,
      ).join("");

      const content = [
        {
          eyebrow: "01 / BUILD",
          heading: "Make the assumption tangible.",
          description:
            "Start with something small enough to test, not a finished product built on an untested idea.",
          question: "A useful first result is enough to get started.",
          label: "THE ASSUMPTION",
          visual: `<div class="pl-browser">${browserTop}${site()}</div><div class="pl-caption">ONE PROMPT → ONE WEBSITE DRAFT</div>`,
        },
        {
          eyebrow: "02 / SHIP",
          heading: "Let the idea meet real use.",
          description:
            "Put a working version in front of a small group. Watch what happens after the first result.",
          question: "Will people feel ready to keep going?",
          label: "THE QUESTION",
          visual: `<div class="pl-browser"><div class="pl-live-strip">Shared with a small test group</div>${site()}</div><div class="pl-caption">A WORKING PRODUCT, NOT A PRESENTATION</div>`,
        },
        {
          eyebrow: "03 / LISTEN",
          heading: "Look for the hesitation.",
          description:
            "The first result is useful. But trying again feels risky. The question has changed.",
          question: "People want to explore without losing their work.",
          label: "THE SIGNAL",
          visual: `<div class="pl-listen-card"><p class="pl-feedback-heading">${icon("listen", 14)}ILLUSTRATIVE FEEDBACK</p><blockquote class="pl-quote">“Will this replace what I already made?”</blockquote><blockquote class="pl-quote">“Can I try another version safely?”</blockquote><p class="pl-observation">The hesitation is about control, not generation.</p></div><div class="pl-caption">LISTEN FOR WHAT THE QUESTION REVEALS</div>`,
        },
        {
          eyebrow: "04 / LEARN",
          heading: "Change what you build next.",
          description:
            "Keep the original. Make alternatives reversible. Then test whether that gives people confidence to explore.",
          question: "Does a safe way back make it easier to try again?",
          label: "THE NEXT HYPOTHESIS",
          visual: `<div class="pl-browser"><div class="pl-versions"><span class="pl-version-chip">${icon("check", 11)}</span><span class="pl-version-chip">Original kept</span><span class="pl-version-current" data-version>Version 01</span></div>${site(true)}</div><div class="pl-caption">TRY THE BUTTON. YOUR ORIGINAL STAYS.</div>`,
        },
      ];

      const panels = content
        .map(
          (stage, i) =>
            `<section class="pl-panel" role="tabpanel" id="${id}-panel-${i}" aria-labelledby="${id}-tab-${i}" tabindex="0" ${i ? "hidden" : ""}>
              <div class="pl-copy"><p class="pl-eyebrow">${stage.eyebrow}</p><h3 class="pl-heading">${stage.heading}</h3><p class="pl-description">${stage.description}</p><div class="pl-question"><small>${stage.label}</small>${stage.question}</div></div>
              <div class="pl-artefact">${stage.visual}</div>
            </section>`,
        )
        .join("");

      return `<div class="pl-machine" role="region" aria-label="An interactive product learning loop">
        <div class="pl-topbar"><div class="pl-label"><span class="pl-power-dot" aria-hidden="true"></span>THE PRODUCT LEARNING LOOP</div><div class="pl-counter">PASS <strong data-pass>01</strong> / 03</div></div>
        <div class="pl-route">
          <svg class="pl-wiring" viewBox="0 0 1000 148" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <g class="pl-paths">
              <path class="pl-wire" d="M125 53H375"/>
              <path class="pl-wire" d="M375 53H625"/>
              <path class="pl-wire" d="M625 53H875"/>
              <path class="pl-wire" d="M875 53V115Q875 138 852 138H148Q125 138 125 115V53"/>
            </g>
            <g class="pl-wire-arrow"><path d="m247 49 5 4-5 4"/><path d="m497 49 5 4-5 4"/><path d="m747 49 5 4-5 4"/><path d="m291 134-5 4 5 4"/><path d="m131 109-6-5-6 5"/></g>
            <path class="pl-wire-active" d="M125 53H375" pathLength="100" stroke-dasharray="0 100"/>
            <ellipse class="pl-signal-halo" cx="125" cy="53" rx="12" ry="12"/>
            <ellipse class="pl-signal" cx="125" cy="53" rx="4" ry="4"/>
          </svg>
          <div class="pl-tabs" role="tablist" aria-label="Explore the four stages">${tabs}</div>
          <div class="pl-loop-label">EVERY ANSWER SHAPES THE NEXT QUESTION</div>
        </div>
        <div class="pl-panels">${panels}</div>
        <div class="pl-footer">
          <div class="pl-pace"><span class="pl-pace-bars" aria-hidden="true"><i class="pl-lit"></i><i></i><i></i></span><span class="pl-pace-text" data-pace>Explore the loop</span></div>
          <div class="pl-controls"><button type="button" class="pl-control" data-play aria-label="Play the product learning loop">${icon("play", 14)}<span>Play</span></button><button type="button" class="pl-control pl-replay" data-replay aria-label="Restart the product learning loop" title="Replay">${icon("replay", 14)}</button></div>
        </div>
        <div class="pl-track-progress" aria-hidden="true"><span></span></div>
        <div class="pl-sr" role="status" aria-live="polite" aria-atomic="true" data-status></div>
        <div class="pl-sr" role="status" aria-live="polite" aria-atomic="true" data-draft-status></div>
      </div>
      <div class="pl-below"><p class="pl-footer-note">Click a stage to explore. Fictional example, not reported customer research. Pace is illustrative. This one was made with <span title="GPT 6 Astra if you're wondering 🤓">ai.</span></p></div>
      <div class="pl-outro-slot"><p class="pl-outro">Then suddenly the whole loop<br>got much faster...</p></div>`;
    }

    class ProductLearningLoop extends HTMLElement {
      constructor() {
        super();
        this._id = `product-loop-${++instanceCount}`;
        this._time = 0;
        this._stage = -1;
        this._pass = -1;
        this._wanted = false;
        this._inView = false;
        this._complete = false;
        this._started = false;
        this._raf = null;
        this._lastTime = null;
        this._ready = false;
        this._draft = 0;
        this._tick = this._tick.bind(this);
      }

      connectedCallback() {
        if (!this._ready) {
          this.innerHTML = template(this._id);
          this._tabs = [...this.querySelectorAll(".pl-step")];
          this._panels = [...this.querySelectorAll(".pl-panel")];
          this._wires = [...this.querySelectorAll(".pl-paths path")];
          this._activeWire = this.querySelector(".pl-wire-active");
          this._signal = this.querySelector(".pl-signal");
          this._halo = this.querySelector(".pl-signal-halo");
          this._progress = this.querySelector(".pl-track-progress span");
          this._playButton = this.querySelector("[data-play]");
          this._status = this.querySelector("[data-status]");
          this._pace = this.querySelector("[data-pace]");
          this._passLabel = this.querySelector("[data-pass]");
          this._bars = [...this.querySelectorAll(".pl-pace-bars i")];
          this._durations = this._readDurations();
          this._total = this._durations.reduce((sum, ms) => sum + ms * 4, 0);
          this._ready = true;
        }

        this._abort?.abort();
        this._abort = new AbortController();
        const opts = { signal: this._abort.signal };
        this._motionQuery = matchMedia("(prefers-reduced-motion: reduce)");
        this._reduced = this._motionQuery.matches;
        this.dataset.reducedMotion = String(this._reduced);

        this._tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => this.selectStage(i), opts);
          tab.addEventListener(
            "keydown",
            (event) => this._onTabKey(event, i),
            opts,
          );
        });

        this._playButton.addEventListener(
          "click",
          () => {
            if (this._reduced) this.selectStage((this._stage + 1) % 4);
            else if (this._wanted) this.pause();
            else this.play();
          },
          opts,
        );
        this.querySelector("[data-replay]").addEventListener(
          "click",
          () => this.restart(),
          opts,
        );
        this.querySelector("[data-try]").addEventListener(
          "click",
          () => this._changeDraft(false),
          opts,
        );
        this.querySelector("[data-restore]").addEventListener(
          "click",
          () => this._changeDraft(true),
          opts,
        );

        this.addEventListener(
          "focusin",
          (event) => {
            if (
              this._wanted &&
              !event.target.closest("[data-play], [data-replay]")
            )
              this.pause();
          },
          opts,
        );
        this._motionQuery.addEventListener(
          "change",
          (event) => {
            this._reduced = event.matches;
            this.dataset.reducedMotion = String(this._reduced);
            if (this._reduced) this.pause();
            this._updateTransport();
          },
          opts,
        );
        document.addEventListener(
          "visibilitychange",
          () => this._syncClock(),
          opts,
        );

        this._resizeObserver?.disconnect();
        if ("ResizeObserver" in window) {
          this._resizeObserver = new ResizeObserver(() => this._sizeSignal());
          this._resizeObserver.observe(this.querySelector(".pl-wiring"));
        }

        const link = this.querySelector(".pl-next");

        this._observer?.disconnect();
        if ("IntersectionObserver" in window) {
          this._observer = new IntersectionObserver(
            (entries) => {
              const entry = entries[entries.length - 1];
              this._inView =
                entry.isIntersecting &&
                entry.intersectionRect.height >=
                  Math.min(150, innerHeight * 0.2);
              if (
                this._inView &&
                !this._started &&
                this.hasAttribute("autoplay") &&
                !this._reduced
              )
                this.play();
              this._syncClock();
            },
            { threshold: [0, 0.05, 0.1, 0.2, 0.3, 0.45, 0.6, 1] },
          );
          this._observer.observe(this.querySelector(".pl-machine"));
        } else {
          this._inView = true;
        }

        this._render();
        this._sizeSignal();
        this._updateTransport();
        if (
          !("IntersectionObserver" in window) &&
          this.hasAttribute("autoplay") &&
          !this._reduced
        )
          this.play();
        this._syncClock();
      }

      disconnectedCallback() {
        this._cancelFrame();
        this._observer?.disconnect();
        this._resizeObserver?.disconnect();
        this._abort?.abort();
      }

      _readDurations() {
        if (!this.hasAttribute("durations")) return [...DEFAULT_DURATIONS];
        try {
          const values = JSON.parse(this.getAttribute("durations"));
          if (
            Array.isArray(values) &&
            values.length === 3 &&
            values.every(
              (value) =>
                Number.isFinite(value) && value >= 600 && value <= 60000,
            )
          ) {
            return values;
          }
        } catch (_) {
          // Invalid input falls back to safe defaults.
        }
        console.warn(
          "product-learning-loop: durations must be three numbers between 600 and 60000 ms. Using defaults.",
        );
        return [...DEFAULT_DURATIONS];
      }

      play() {
        if (!this._ready) return;
        this._started = true;
        if (this._reduced) {
          this._wanted = false;
          this._updateTransport();
          return;
        }
        if (this._complete) {
          this._time = 0;
          this._complete = false;
          this._stage = -1;
          this._resetDraft();
        }
        this._wanted = true;
        this._render();
        this._updateTransport();
        this._syncClock();
      }

      pause() {
        this._started = true;
        this._wanted = false;
        this._cancelFrame();
        if (this._ready) this._updateTransport();
      }

      restart() {
        if (!this._ready) return;
        this.pause();
        this._time = 0;
        this._complete = false;
        this._stage = -1;
        this._pass = -1;
        this._resetDraft();
        this._render();
        if (!this._reduced) this.play();
        else {
          this._updateTransport();
          this._announce("Build. Make the assumption tangible.");
        }
      }

      selectStage(index) {
        if (!Number.isInteger(index) || index < 0 || index > 3) {
          throw new RangeError("selectStage expects an integer from 0 to 3.");
        }
        if (!this._ready) return;
        this.pause();
        this._complete = false;
        this._time = index * this._durations[0];
        this._render("manual");
        this._updateTransport();
        this._announce(
          `${NAMES[index]}. ${this._panels[index].querySelector(".pl-heading").textContent}`,
        );
      }

      setProgress(progress) {
        if (!Number.isFinite(progress))
          throw new TypeError("setProgress expects a finite number.");
        if (!this._ready) return;
        this.pause();
        this._time = Math.min(1, Math.max(0, progress)) * this._total;
        if (this._time < this._total) this._complete = false;
        this._render("scrub");
        this._updateTransport();
      }

      get progress() {
        return this._total ? this._time / this._total : 0;
      }

      get playing() {
        return (
          this._wanted && this._inView && !document.hidden && !this._reduced
        );
      }

      get stage() {
        return Math.max(0, this._stage);
      }

      _syncClock() {
        if (
          this._wanted &&
          this._inView &&
          !document.hidden &&
          !this._reduced &&
          this.isConnected &&
          !this._complete
        ) {
          if (this._raf === null) {
            this._lastTime = null;
            this._raf = requestAnimationFrame(this._tick);
          }
        } else {
          this._cancelFrame();
        }
        this.dataset.paused = String(!this.playing);
      }

      _cancelFrame() {
        if (this._raf !== null) cancelAnimationFrame(this._raf);
        this._raf = null;
        this._lastTime = null;
      }

      _tick(now) {
        this._raf = null;
        if (!this.playing || !this.isConnected) {
          this._lastTime = null;
          return;
        }
        if (this._lastTime !== null)
          this._time += Math.min(now - this._lastTime, 100);
        this._lastTime = now;
        this._time = Math.min(this._time, this._total);
        this._render("playback");
        if (!this._complete && this.playing)
          this._raf = requestAnimationFrame(this._tick);
      }

      _positionAt(time) {
        let remainder = Math.min(time, this._total - 0.001);
        for (let pass = 0; pass < this._durations.length; pass += 1) {
          const length = this._durations[pass] * 4;
          if (remainder < length) {
            const stage = Math.floor(remainder / this._durations[pass]);
            return {
              pass,
              stage,
              fraction:
                (remainder % this._durations[pass]) / this._durations[pass],
            };
          }
          remainder -= length;
        }
        return { pass: 2, stage: 3, fraction: 1 };
      }

      _render(source = "initial") {
        if (!this._ready) return;
        const { pass, stage, fraction } = this._positionAt(this._time);

        if (stage !== this._stage) {
          this._stage = stage;
          this._tabs.forEach((tab, i) => {
            tab.setAttribute("aria-selected", String(i === stage));
            tab.tabIndex = i === stage ? 0 : -1;
            this._panels[i].hidden = i !== stage;
            this._panels[i].classList.remove("pl-enter");
          });
          if (!this._reduced && source !== "scrub")
            this._panels[stage].classList.add("pl-enter");
          const path = this._wires[stage];
          const d = path.getAttribute("d");
          this._activeWire.setAttribute("d", d);
          this._pathLength = path.getTotalLength();
          this.dispatchEvent(
            new CustomEvent("product-loop:stagechange", {
              bubbles: true,
              detail: { stage, name: NAMES[stage].toLowerCase(), pass, source },
            }),
          );
        }

        if (pass !== this._pass) {
          this._pass = pass;
          this._passLabel.textContent = String(pass + 1).padStart(2, "0");
          this._bars.forEach((bar, i) =>
            bar.classList.toggle("pl-lit", i <= pass),
          );
          this._updateTransport();
        }

        const point = this._wires[stage].getPointAtLength(
          (this._pathLength || 0) * fraction,
        );
        this._signal.setAttribute("cx", point.x);
        this._signal.setAttribute("cy", point.y);
        this._halo.setAttribute("cx", point.x);
        this._halo.setAttribute("cy", point.y);
        this._activeWire.setAttribute(
          "stroke-dasharray",
          `${fraction * 100} 100`,
        );
        this._progress.style.transform = `scaleX(${this.progress})`;
        if (this._time >= this._total && !this._complete) this._finish();
        this.dataset.complete = String(this._complete);
        this.dataset.stage = NAMES[stage].toLowerCase();
      }

      _finish() {
        this._complete = true;
        this._wanted = false;
        this._cancelFrame();
        this._updateTransport();
        this._announce(
          "Loop complete. Faster tools still leave a decision to make. You can explore any stage or replay.",
        );
        this.dispatchEvent(
          new CustomEvent("product-loop:complete", {
            bubbles: true,
            detail: { source: "sequence", passes: 3 },
          }),
        );
      }

      _updateTransport() {
        if (!this._ready) return;
        this.dataset.paused = String(!this.playing);
        const mode = this._reduced
          ? "next"
          : this._complete
            ? "replay"
            : this._wanted
              ? "pause"
              : "play";
        if (this._playButton.dataset.mode !== mode) {
          this._playButton.dataset.mode = mode;
          const name = {
            next: "Next step",
            replay: "Replay",
            pause: "Pause",
            play: "Play",
          }[mode];
          const image = {
            next: "arrow",
            replay: "replay",
            pause: "pause",
            play: "play",
          }[mode];
          this._playButton.innerHTML = `${icon(image, 14)}<span>${name}</span>`;
          this._playButton.setAttribute(
            "aria-label",
            mode === "next"
              ? "Show the next stage without animation"
              : `${name} the product learning loop`,
          );
        }
        this._pace.textContent = this._reduced
          ? "Motion reduced"
          : this._complete
            ? "A new question. Repeat."
            : !this._wanted
              ? "Explore at your pace"
              : [
                  "First, understand.",
                  "Then, iterate.",
                  "The loop gets faster.",
                ][Math.max(0, this._pass)];
      }

      _sizeSignal() {
        if (!this._ready) return;
        const rect = this.querySelector(".pl-wiring").getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        this._signal.setAttribute("rx", 3.5 * (1000 / rect.width));
        this._signal.setAttribute("ry", 3.5 * (148 / rect.height));
        this._halo.setAttribute("rx", 10 * (1000 / rect.width));
        this._halo.setAttribute("ry", 10 * (148 / rect.height));
      }

      _onTabKey(event, index) {
        let next;
        if (event.key === "ArrowRight") next = (index + 1) % 4;
        else if (event.key === "ArrowLeft") next = (index + 3) % 4;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = 3;
        else return;
        event.preventDefault();
        this.selectStage(next);
        this._tabs[next].focus();
      }

      _announce(message) {
        this._status.textContent = message;
      }

      _resetDraft() {
        this._draft = 0;
        this._drawDraft();
        this.querySelector("[data-draft-status]").textContent = "";
      }

      _changeDraft(restore) {
        this.pause();
        this._draft = restore ? 0 : (this._draft + 1) % 3;
        this._drawDraft();
        this.querySelector("[data-draft-status]").textContent = restore
          ? "Original version restored."
          : `Showing version ${this._draft + 1}. The original is still saved.`;
      }

      _drawDraft() {
        const titles = [
          "A home for<br>late-night ideas.",
          "Make room<br>for your next idea.",
          "Good things<br>start with a sound.",
        ];
        this.querySelector("[data-draft-title]").innerHTML =
          titles[this._draft];
        this.querySelector("[data-version]").textContent =
          `Version ${String(this._draft + 1).padStart(2, "0")}`;
        const svg = this.querySelector(".pl-learn-site .pl-art");
        svg
          .querySelector("rect")
          .setAttribute("fill", ["#cdabed", "#b2cce9", "#d8db9a"][this._draft]);
      }
    }

    customElements.define("product-learning-loop", ProductLearningLoop);
  })();
</script>
