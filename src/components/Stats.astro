---
import { siteConfig } from "~/config/site";
const { stats } = siteConfig;
---

<section class="section" id="stats">
  <div class="section-head">
    <p class="kicker">{stats.kicker}</p>
    <h2>{stats.heading}</h2>
  </div>
  <div class="stats-row">
    {stats.items.map((s) => (
      <div class:list={["stat", s.color]}>
        <div class="v">
          <span class="relative">
            {s.value}
            {s.label === "Websites created" && (
              <>
                <button
                  class="stat-what"
                  data-popover-trigger
                  type="button"
                  aria-controls="websites-created-popover"
                  aria-expanded="false"
                >
                  what?
                </button>
                <div
                  id="websites-created-popover"
                  class="popover stat-popover"
                  data-popover
                  popover="auto"
                  role="status"
                >
                  Yes, that is correct, I have created over 3 million websites.
                  Mixo, the AI website product I built, is on its way to 3.5
                  million! Wild 🤓
                </div>
              </>
            )}
          </span>
        </div>
        <div class="l">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<script>
  import { setupPopovers } from "~/scripts/popover";

  setupPopovers();
</script>
