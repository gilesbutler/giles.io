---
import { siteConfig } from "~/config/site";
const { footer, name } = siteConfig;

const socialIcons: Record<string, string> = {
  x: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h3l-7 8 8 12h-6l-5-7-6 7H2l8-9L2 2h6l4 6z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4a2 2 0 110 4 2 2 0 010-4zM2 9h4v12H2zM9 9h4v2c.6-1 2-2 4-2 3 0 5 2 5 6v7h-4v-6c0-2-1-3-2-3s-2 1-2 3v6H9z"/></svg>',
  bluesky:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8C10.9 8.6 7.9 4.6 5.1 3.1 2.4 1.7 1.4 2 1 2.5c-.4.5-.5 2.2-.5 3.2 0 1 .6 8 1 9.2.4 1.3 1.2 1.7 2.2 1.5 1-.2 3.6-.7 8.3-4.7-4.1 5.7-4.7 6.9-4.4 7.8.3.8 1.4.8 2.2.5 1-.4 1.9-1.1 2.2-1.6.3.5 1.2 1.2 2.2 1.6.8.3 1.9.3 2.2-.5.3-.9-.3-2.1-4.4-7.8 4.7 4 7.3 4.5 8.3 4.7 1 .2 1.8-.2 2.2-1.5.4-1.2 1-8.2 1-9.2 0-1-.1-2.7-.5-3.2-.4-.5-1.4-.8-4.1.6-2.8 1.5-5.8 5.5-6.9 7.7Z"/></svg>',
  dribbble:
    '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M5 8c5 2 10 3 14 2M8 4c4 5 6 10 6 16M3 13c6-2 11-1 15 4" stroke="currentColor" stroke-width="1.6"/></svg>',
};
---

<footer class="ft">
  <div class="ft-card">
    <div class="ft-top">
      <div class="ft-brand">
        <span class="mark"><b>{name}<span class="logo-dot">.</span></b></span>
        <p>{footer.bio}</p>
        <p class="mono-label avail"><span class="dot"></span> {footer.availability}</p>
      </div>
      {footer.columns.map((col) => (
        <div class="ft-col">
          <h5>{col.heading}</h5>
          {col.links.map((l) => (
            <a href={l.url} target={l.url.startsWith("http") ? "_blank" : undefined} rel={l.url.startsWith("http") ? "noopener" : undefined}>
              {l.label}
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="ft-bar">
      <div class="socials">
        {footer.socials.map((sc) => (
          <a href={sc.url} target="_blank" rel="noopener" aria-label={sc.label} set:html={socialIcons[sc.icon] ?? ""}></a>
        ))}
      </div>
      <p class="made">
        {footer.copyright} {footer.backlink.prefix}
        <a href={footer.backlink.url} target="_blank" rel="noopener">{footer.backlink.label}</a>
      </p>
    </div>
  </div>
</footer>
