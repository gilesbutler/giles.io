<section class="signal-prototype signal-console" aria-labelledby="console-title">
  <header class="console-top"><span class="console-mark">G / 04</span><span>TRANSMISSION MAP</span><span class="console-live"><i></i> LIVE SYSTEM</span></header>
  <div class="console-hero">
    <div class="console-heading"><p class="console-kicker">A practice in four channels</p><h2 id="console-title">Follow the <span>flow.</span></h2><p>Ideas become useful when they can move between disciplines without losing their charge.</p></div>
    <div class="console-readout"><span>PATH STATUS</span><strong>ALIGNING</strong><small>04 / 04 channels online</small></div>
  </div>
  <div class="console-map" aria-label="Signal routing map">
    <div class="console-column console-inputs"><span class="console-column-title">INPUTS</span><span class="console-channel cyan"><b>01</b> MUSIC<small>rhythm / feeling</small></span><span class="console-channel pink"><b>02</b> DESIGN<small>shape / meaning</small></span><span class="console-channel amber"><b>03</b> ENGINEERING<small>logic / leverage</small></span><span class="console-channel green"><b>04</b> PRODUCT<small>use / outcome</small></span></div>
    <svg class="console-lines" viewBox="0 0 1000 720" preserveAspectRatio="none" aria-hidden="true"><path class="console-path cp1" d="M0 92 C245 92 250 172 500 172 S760 362 1000 362"/><path class="console-path cp2" d="M0 220 C225 220 275 250 500 250 S725 362 1000 362"/><path class="console-path cp3" d="M0 348 C260 348 300 328 500 328 S740 362 1000 362"/><path class="console-path cp4" d="M0 476 C250 476 280 410 500 410 S735 362 1000 362"/><path class="console-spine" d="M500 362 L1000 362"/><circle cx="500" cy="362" r="13"/><circle cx="1000" cy="362" r="7"/></svg>
    <div class="console-column console-output"><span class="console-column-title">OUTPUT</span><div class="console-output-card"><span class="output-dot"></span><strong>ONE PRACTICE</strong><small>clear enough to use<br />alive enough to remember</small></div></div>
  </div>
  <div class="console-footnotes"><article><span>01</span><h3>Collect</h3><p>Hear the signal before reaching for the solution.</p></article><article><span>02</span><h3>Translate</h3><p>Give each discipline a job in the same system.</p></article><article><span>03</span><h3>Connect</h3><p>Make the final experience feel inevitable.</p></article></div>
  <footer class="console-bottom"><span>SCROLL / ROUTE THE CHANNELS</span><span>STATUS: <b>CONVERGING</b></span></footer>
</section>
<style>
  .signal-prototype { --console-bg:#151719; --console-panel:#1c2022; --console-line:#394044; --console-ink:#eff2ed; --console-muted:#9ca7a4; --console-cyan:#36c5f0; --console-pink:#e01e5a; --console-amber:#ecb22e; --console-green:#2eb67d; position:relative; overflow:hidden; min-height:1600px; background:var(--console-bg); color:var(--console-ink); font-family:var(--font-body); isolation:isolate; }.signal-console::before { content:""; position:absolute; inset:0; opacity:.25; background-image:linear-gradient(var(--console-line) 1px,transparent 1px),linear-gradient(90deg,var(--console-line) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,black,transparent 75%); pointer-events:none; }.console-top,.console-bottom { position:relative; z-index:2; display:flex; justify-content:space-between; padding:25px clamp(24px,6vw,90px); color:var(--console-muted); font:500 10px/1 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; border-bottom:1px solid var(--console-line); }.console-live { display:flex; align-items:center; gap:8px; }.console-live i { width:6px; height:6px; border-radius:50%; background:var(--console-green); box-shadow:0 0 0 4px rgba(46,182,125,.15); }.console-hero { position:relative; z-index:2; display:flex; justify-content:space-between; gap:30px; padding:clamp(72px,12vw,160px) clamp(24px,10vw,150px) 90px; }.console-heading { max-width:620px; }.console-kicker { margin:0 0 20px; color:var(--console-cyan); font:500 11px/1 var(--font-mono); letter-spacing:.14em; text-transform:uppercase; }.console-heading h2 { margin:0; font:900 clamp(68px,12vw,160px)/.84 var(--font-display); letter-spacing:-.08em; text-transform:uppercase; }.console-heading h2 span { color:var(--console-cyan); }.console-heading>p:last-child { max-width:34ch; margin:30px 0 0; color:var(--console-muted); font-size:17px; line-height:1.45; }.console-readout { align-self:flex-end; display:grid; gap:12px; min-width:160px; padding:14px; border:1px solid var(--console-line); background:rgba(28,32,34,.72); font:10px/1.3 var(--font-mono); color:var(--console-muted); }.console-readout strong { color:var(--console-amber); font:500 20px/1 var(--font-mono); }.console-map { position:relative; z-index:2; display:grid; grid-template-columns:minmax(180px,1fr) minmax(230px,2fr) minmax(180px,1fr); min-height:720px; margin:0 clamp(24px,6vw,90px); border:1px solid var(--console-line); background:rgba(21,23,25,.55); }.console-column { display:flex; flex-direction:column; gap:0; }.console-inputs { padding:32px 0; border-right:1px solid var(--console-line); }.console-output { padding:32px; border-left:1px solid var(--console-line); justify-content:center; }.console-column-title { padding:0 24px 28px; color:var(--console-muted); font:500 10px/1 var(--font-mono); letter-spacing:.16em; }.console-channel { position:relative; display:flex; flex-direction:column; gap:6px; justify-content:center; height:128px; padding:0 24px; border-top:1px solid var(--console-line); font:500 13px/1 var(--font-mono); letter-spacing:.08em; }.console-channel b { position:absolute; right:20px; top:17px; color:var(--console-muted); font-size:10px; }.console-channel small { color:var(--console-muted); font:12px/1.2 var(--font-body); letter-spacing:0; }.console-channel::before { content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:currentColor; }.cyan{color:var(--console-cyan)}.pink{color:var(--console-pink)}.amber{color:var(--console-amber)}.green{color:var(--console-green)}.console-lines { position:absolute; top:0; left:calc(26% + 1px); width:48%; height:100%; overflow:visible; }.console-path,.console-spine { fill:none; stroke-width:2; vector-effect:non-scaling-stroke; stroke-linecap:round; stroke-dasharray:1; stroke-dashoffset:1; animation:console-route 1.25s cubic-bezier(.19,1,.22,1) forwards; }.cp1{stroke:var(--console-cyan);animation-delay:.1s}.cp2{stroke:var(--console-pink);animation-delay:.2s}.cp3{stroke:var(--console-amber);animation-delay:.3s}.cp4{stroke:var(--console-green);animation-delay:.4s}.console-spine{stroke:var(--console-ink);stroke-width:3;animation-delay:1s}.console-lines circle{fill:var(--console-bg);stroke:var(--console-ink);stroke-width:2;vector-effect:non-scaling-stroke;animation:console-node .35s cubic-bezier(.19,1,.22,1) 1.1s both}.console-lines circle:last-child{animation-delay:1.35s}.console-output-card{display:grid;gap:14px;padding:24px;border:1px solid var(--console-line);box-shadow:8px 8px 0 rgba(54,197,240,.12);}.output-dot{width:12px;height:12px;border-radius:50%;background:var(--console-cyan);box-shadow:0 0 0 6px rgba(54,197,240,.12)}.console-output-card strong{font:700 17px/1 var(--font-display);letter-spacing:.02em}.console-output-card small{color:var(--console-muted);font-size:12px;line-height:1.45}.console-footnotes{position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 clamp(24px,10vw,150px);padding:90px 0 130px}.console-footnotes article{border-top:1px solid var(--console-line);padding-top:18px}.console-footnotes span{color:var(--console-cyan);font:500 11px/1 var(--font-mono)}.console-footnotes h3{margin:24px 0 8px;font:700 28px/1 var(--font-body);letter-spacing:-.04em}.console-footnotes p{max-width:24ch;margin:0;color:var(--console-muted);line-height:1.45}.console-bottom{border-top:1px solid var(--console-line);border-bottom:0}.console-bottom b{color:var(--console-cyan);font-weight:500}@keyframes console-route{to{stroke-dashoffset:0}}@keyframes console-node{from{opacity:0;transform:scale(.7);transform-origin:center}to{opacity:1;transform:scale(1);transform-origin:center}}@media(max-width:700px){.console-hero{display:block;padding-top:90px}.console-readout{margin-top:40px;width:max-content}.console-map{grid-template-columns:1fr;min-height:940px}.console-inputs{border:0}.console-lines{left:20%;top:265px;width:60%;height:390px;transform:rotate(90deg);transform-origin:center}.console-output{min-height:250px;border:0;border-top:1px solid var(--console-line)}.console-footnotes{grid-template-columns:1fr;padding-top:70px}.console-top span:nth-child(2){display:none}}@media(prefers-reduced-motion:reduce){.console-path,.console-spine{animation:none;stroke-dashoffset:0}.console-lines circle{animation:none}}
</style>
