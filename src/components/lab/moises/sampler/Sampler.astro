<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 550"
  width="100%"
  height="100%"
  style="background: #08090C;"
>
  <defs>
    <!-- Subtle Neon Glow Filter -->
    <filter id="neon-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Screen Grid Texture -->
    <pattern
      id="screen-grid"
      width="8"
      height="8"
      patternUnits="userSpaceOnUse"
    >
      <path
        d="M 8 0 L 0 0 0 8"
        fill="none"
        stroke="rgba(0, 240, 255, 0.12)"
        stroke-width="0.8"
      />
    </pattern>
  </defs>

  <style>
    .wireframe {
      fill: none;
      stroke: rgba(255, 255, 255, 0.3);
      stroke-width: 1.2;
    }
    .wireframe-dim {
      fill: none;
      stroke: rgba(255, 255, 255, 0.1);
      stroke-width: 1;
    }
    .chassis-top {
      fill: #0d0e14;
      stroke: rgba(255, 255, 255, 0.4);
      stroke-width: 1.2;
    }
    .neon-cyan {
      fill: none;
      stroke: #00f0ff;
      stroke-width: 1.5;
      filter: url(#neon-glow);
    }
    .neon-pad {
      fill: rgba(0, 240, 255, 0.08);
      stroke: #00f0ff;
      stroke-width: 1.5;
      filter: url(#neon-glow);
    }
  </style>

  <!-- BASE LAYER (Chassis Bottom) -->
  <g transform="translate(400, 335) scale(1, 0.5774) rotate(-45)">
    <rect
      x="-180"
      y="-130"
      width="360"
      height="260"
      rx="16"
      class="wireframe-dim"
    />
  </g>

  <!-- CHASSIS VERTICAL DEPTH (Screen-Space Edges) -->
  <path d="M 216 323 L 216 288" class="wireframe" />
  <path d="M 584 323 L 584 288" class="wireframe" />
  <path d="M 400 427 L 400 392" class="wireframe" />

  <!-- TOP LAYER (Hardware Surface - Raised 35px on Screen Y) -->
  <g transform="translate(400, 300) scale(1, 0.5774) rotate(-45)">
    <!-- Main Chassis Face -->
    <rect
      x="-180"
      y="-130"
      width="360"
      height="260"
      rx="16"
      class="chassis-top"
    />

    <!-- DISPLAY SCREEN -->
    <g transform="translate(-155, -105)">
      <rect x="0" y="0" width="130" height="85" rx="6" class="wireframe" />
      <rect
        x="5"
        y="5"
        width="120"
        height="75"
        rx="4"
        fill="url(#screen-grid)"
        stroke="rgba(0, 240, 255, 0.3)"
        stroke-width="1"
      />
      <!-- Waveform -->
      <path
        d="M 15 42 L 35 42 L 45 20 L 55 65 L 65 28 L 75 52 L 85 42 L 115 42"
        class="neon-cyan"
      />
    </g>

    <!-- ROTARY KNOBS -->
    <g transform="translate(10, -105)">
      <!-- Knob 1 (Active Accent) -->
      <circle cx="25" cy="22" r="16" class="wireframe" />
      <line
        x1="25"
        y1="22"
        x2="25"
        y2="8"
        stroke="#00f0ff"
        stroke-width="2"
        filter="url(#neon-glow)"
      />

      <!-- Knob 2 -->
      <circle cx="70" cy="22" r="16" class="wireframe" />
      <line x1="70" y1="22" x2="81" y2="11" class="wireframe" />

      <!-- Knob 3 -->
      <circle cx="115" cy="22" r="16" class="wireframe" />
      <line x1="115" y1="22" x2="115" y2="36" class="wireframe" />
    </g>

    <!-- DRUM PADS (4x3 Grid) -->
    <!-- Row 1 -->
    <rect x="-155" y="0" width="65" height="32" rx="4" class="wireframe" />
    <rect x="-77" y="0" width="65" height="32" rx="4" class="wireframe" />
    <rect x="1" y="0" width="65" height="32" rx="4" class="neon-pad" />
    <!-- Highlighted Pad -->
    <rect x="79" y="0" width="65" height="32" rx="4" class="wireframe" />

    <!-- Row 2 -->
    <rect x="-155" y="40" width="65" height="32" rx="4" class="wireframe" />
    <rect x="-77" y="40" width="65" height="32" rx="4" class="wireframe" />
    <rect x="1" y="40" width="65" height="32" rx="4" class="wireframe" />
    <rect x="79" y="40" width="65" height="32" rx="4" class="wireframe" />

    <!-- Row 3 -->
    <rect x="-155" y="80" width="65" height="32" rx="4" class="wireframe" />
    <rect x="-77" y="80" width="65" height="32" rx="4" class="wireframe" />
    <rect x="1" y="80" width="65" height="32" rx="4" class="wireframe" />
    <rect x="79" y="80" width="65" height="32" rx="4" class="wireframe" />
  </g>
</svg>
