---
---

<section
  class="moises-comparison !mt-8"
  data-comparison
  data-mode="less"
  aria-labelledby="comparison-title"
>
  <div class="comparison-topline">
    <div class="play-cue" aria-hidden="true">
      <span class="hand">Play with it</span>
      <svg viewBox="0 0 90 56" role="presentation">
        <path d="M4 7c27 3 48 16 61 38" />
        <path d="m54 42 12 4 1-12" />
      </svg>
    </div>

    <div
      class="mode-switch"
      role="group"
      aria-label="Choose the interface detail level"
    >
      <button type="button" data-mode-button="more" aria-pressed="false">
        More
      </button>
      <button type="button" data-mode-button="less" aria-pressed="true">
        Less
      </button>
    </div>
  </div>

  <div class="comparison-stage">
    <article
      class="comparison-card interface-frame"
      aria-labelledby="comparison-title"
    >
      <div class="card-header">
        <div class="product-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path d="M4 25h4m4-8v16m5-22v28m6-34v40m6-32v24m6-17v10m6-4v0" />
          </svg>
        </div>
        <div class="card-heading">
          <h3 id="comparison-title">Vocal Separation</h3>
          <p data-mode-copy="more" hidden>
            Separate vocals, drums, bass and other instruments
          </p>
          <p data-mode-copy="less">Extract vocals, drums, bass and more.</p>
        </div>
        <div class="mode-actions" data-more-only hidden>
          <div class="card-actions">
            <button
              type="button"
              class="version-button"
              aria-label="Change version"
            >
              v2 <span aria-hidden="true">⌄</span>
            </button>
            <button type="button" class="more-button" aria-label="More options">
              <i></i>
              <i></i>
              <i></i>
            </button>
          </div>
        </div>
      </div>

      <div class="interface-view more-view" data-panel="more" hidden>
        <div class="more-interface">
          <div class="category-tabs" role="tablist" aria-label="Audio type">
            <button
              type="button"
              class="is-active"
              data-tab="Music"
              role="tab"
              aria-selected="true"
            >
              Music
            </button>
            <button
              type="button"
              data-tab="Podcast"
              role="tab"
              aria-selected="false"
            >
              Podcast
            </button>
            <button
              type="button"
              data-tab="Interview"
              role="tab"
              aria-selected="false"
            >
              Interview
            </button>
            <button
              type="button"
              data-tab="Other"
              role="tab"
              aria-selected="false"
            >
              Other
            </button>
          </div>

          <div class="controls-grid">
            <div class="stem-controls">
              <div class="stem-grid" aria-label="Choose stems">
                <button
                  type="button"
                  class="stem is-selected"
                  data-stem
                  aria-pressed="true"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 18.5a3 3 0 1 1-2-2.83V5l10-2v10.5a3 3 0 1 1-2-2.83V6.8L9 8.1v10.4Z" />
                  </svg>
                  <span>Vocals</span>
                  <i class="stem-check" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="stem is-selected"
                  data-stem
                  aria-pressed="true"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 10h2v5H4zm3-3h2v11H7zm3 2h4v6h-4zm5-4h2v14h-2zm3 3h2v8h-2zM3 18h18" />
                  </svg>
                  <span>Drums</span>
                  <i class="stem-check" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="stem is-selected"
                  data-stem
                  aria-pressed="true"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m14 4-2 4 3 2-4 7.5a3.25 3.25 0 1 1-1.35-1.25L13 10l-3-2 4-4Zm-7.4 14.5a1.2 1.2 0 1 0 1.2 1.2 1.2 1.2 0 0 0-1.2-1.2Z" />
                  </svg>
                  <span>Bass</span>
                  <i class="stem-check" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="stem"
                  data-stem
                  aria-pressed="false"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 12h3m3-4v8m3-11v14m3-10v4m3-7v10m3-5h2" />
                  </svg>
                  <span>Other</span>
                  <i class="stem-check" aria-hidden="true"></i>
                </button>
              </div>

              <div class="field-group file-field">
                <span class="field-label">File format</span>
                <button type="button" class="select-button">
                  WAV (High quality)<span aria-hidden="true">⌄</span>
                </button>
              </div>
            </div>

            <div class="advanced-settings">
              <button
                type="button"
                class="settings-heading"
                data-settings-toggle
                aria-expanded="true"
              >
                Advanced settings <span aria-hidden="true">⌄</span>
              </button>
              <div class="settings-fields" data-settings-fields>
                <label class="field-group">
                  <span class="field-label">Model</span>
                  <span class="select-button">
                    Balanced<span aria-hidden="true">⌄</span>
                  </span>
                </label>
                <label class="field-group">
                  <span class="field-label">Quality</span>
                  <span class="select-button">
                    High (Slower)<span aria-hidden="true">⌄</span>
                  </span>
                </label>
                <span class="switch-row">
                  <span>Noise reduction</span>
                  <i class="switch is-on" aria-hidden="true"></i>
                </span>
                <span class="switch-row">
                  <span>Keep reverb</span>
                  <i class="switch" aria-hidden="true"></i>
                </span>
              </div>
            </div>
          </div>

          <div class="upload-row">
            <div class="upload-zone">
              <span class="plus" aria-hidden="true">
                +
              </span>
              <span>
                <strong>Drag and drop an audio file</strong>
                <small>MP3, WAV, M4A, FLAC up to 500MB</small>
              </span>
            </div>
            <button type="button" class="primary-action" data-separate>
              Separate Audio
            </button>
          </div>
        </div>
      </div>

      <div class="interface-view less-view" data-panel="less">
        <div class="simple-interface">
          <button type="button" class="drop-zone">
            <span class="drop-plus" aria-hidden="true">
              +
            </span>
            <strong>Drop your audio file</strong>
            <small>MP3, WAV, M4A, FLAC</small>
          </button>
          <div class="simple-controls">
            <button
              type="button"
              class="advanced-toggle"
              data-simple-settings
              aria-expanded="false"
            >
              Advanced options <span aria-hidden="true">⌄</span>
            </button>
            <button type="button" class="primary-action" data-separate>
              Separate
            </button>
          </div>
          <div class="simple-settings" data-simple-settings-panel hidden>
            <div class="simple-settings-heading">
              <span class="field-label">Customize separation</span>
            </div>

            <div class="simple-option-block">
              <span class="field-label">Audio type</span>
              <div
                class="simple-mode-tabs"
                role="tablist"
                aria-label="Audio type"
              >
                <button
                  type="button"
                  class="is-active"
                  data-simple-tab
                  role="tab"
                  aria-selected="true"
                >
                  Music
                </button>
                <button
                  type="button"
                  data-simple-tab
                  role="tab"
                  aria-selected="false"
                >
                  Podcast
                </button>
                <button
                  type="button"
                  data-simple-tab
                  role="tab"
                  aria-selected="false"
                >
                  Interview
                </button>
                <button
                  type="button"
                  data-simple-tab
                  role="tab"
                  aria-selected="false"
                >
                  Other
                </button>
              </div>
            </div>

            <div class="simple-option-block">
              <span class="field-label">Stems</span>
              <div class="simple-stem-list" aria-label="Choose stems">
                <button
                  type="button"
                  class="simple-chip is-selected"
                  data-simple-stem
                  aria-pressed="true"
                >
                  Vocals
                </button>
                <button
                  type="button"
                  class="simple-chip is-selected"
                  data-simple-stem
                  aria-pressed="true"
                >
                  Drums
                </button>
                <button
                  type="button"
                  class="simple-chip is-selected"
                  data-simple-stem
                  aria-pressed="true"
                >
                  Bass
                </button>
                <button
                  type="button"
                  class="simple-chip"
                  data-simple-stem
                  aria-pressed="false"
                >
                  Other
                </button>
              </div>
            </div>

            <div class="simple-option-grid">
              <div class="simple-option">
                <span class="field-label">File format</span>
                <button type="button" class="compact-select">
                  WAV <span>High quality</span>
                  <b aria-hidden="true">⌄</b>
                </button>
              </div>
              <div class="simple-option">
                <span class="field-label">Model</span>
                <button type="button" class="compact-select">
                  Balanced<b aria-hidden="true">⌄</b>
                </button>
              </div>
              <div class="simple-option">
                <span class="field-label">Quality</span>
                <button type="button" class="compact-select">
                  High <span>Slower</span>
                  <b aria-hidden="true">⌄</b>
                </button>
              </div>
            </div>

            <div class="simple-toggle-grid">
              <button
                type="button"
                class="simple-toggle is-on"
                data-simple-toggle
                aria-pressed="true"
              >
                <span>Noise reduction</span>
                <i class="mini-switch" aria-hidden="true"></i>
              </button>
              <button
                type="button"
                class="simple-toggle"
                data-simple-toggle
                aria-pressed="false"
              >
                <span>Keep reverb</span>
                <i class="mini-switch" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>

  <p class="comparison-status" data-status aria-live="polite"></p>

  <div class="comparison-foot !mt-4 md:!mt-12">
    <article>
      <span class="foot-label">More options</span>
      <ul>
        <li>Multiple modes</li>
        <li>Individual stem selection</li>
        <li>Advanced settings</li>
        <li>File format, noise reduction</li>
        <li>
          <em>More decisions, more complexity</em>
        </li>
      </ul>
    </article>
    <span class="foot-divider" aria-hidden="true"></span>
    <article>
      <span class="foot-label">Less, but better</span>
      <ul>
        <li>Same powerful technology</li>
        <li>Fewer decisions</li>
        <li>A clearer path to the result</li>
        <li>Designed for focus</li>
      </ul>
    </article>
  </div>
</section>

<script>
  const comparison = document.querySelector("[data-comparison]");

  if (comparison instanceof HTMLElement) {
    const modeButtons =
      comparison.querySelectorAll<HTMLButtonElement>("[data-mode-button]");
    const tabs = comparison.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const stems = comparison.querySelectorAll<HTMLButtonElement>("[data-stem]");
    const panels = comparison.querySelectorAll<HTMLElement>("[data-panel]");
    const modeCopies =
      comparison.querySelectorAll<HTMLElement>("[data-mode-copy]");
    const moreOnly =
      comparison.querySelectorAll<HTMLElement>("[data-more-only]");
    const status = comparison.querySelector("[data-status]");

    const setMode = (mode: string) => {
      comparison.dataset.mode = mode;
      modeButtons.forEach((button) => {
        const isActive = button.dataset.modeButton === mode;
        button.setAttribute("aria-pressed", String(isActive));
      });
      panels.forEach((panel) => {
        const isActive = panel.dataset.panel === mode;
        panel.toggleAttribute("hidden", !isActive);
        panel.setAttribute("aria-hidden", String(!isActive));
      });
      modeCopies.forEach((copy) => {
        copy.toggleAttribute("hidden", copy.dataset.modeCopy !== mode);
      });
      moreOnly.forEach((element) =>
        element.toggleAttribute("hidden", mode !== "more"),
      );
    };

    setMode(comparison.dataset.mode || "less");

    modeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.modeButton;
        if (mode) setMode(mode);
      });
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((item) => {
          const isActive = item === tab;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });
      });
    });

    stems.forEach((stem) => {
      stem.addEventListener("click", () => {
        const isSelected = stem.classList.toggle("is-selected");
        stem.setAttribute("aria-pressed", String(isSelected));
      });
    });

    const settingsToggle = comparison.querySelector<HTMLButtonElement>(
      "[data-settings-toggle]",
    );
    const settingsFields = comparison.querySelector<HTMLElement>(
      "[data-settings-fields]",
    );
    settingsToggle?.addEventListener("click", () => {
      const isExpanded =
        settingsToggle.getAttribute("aria-expanded") === "true";
      settingsToggle.setAttribute("aria-expanded", String(!isExpanded));
      settingsFields?.toggleAttribute("hidden", isExpanded);
    });

    const simpleSettingsToggle = comparison.querySelector<HTMLButtonElement>(
      "[data-simple-settings]",
    );
    const simpleSettingsPanel = comparison.querySelector<HTMLElement>(
      "[data-simple-settings-panel]",
    );
    simpleSettingsToggle?.addEventListener("click", () => {
      const isExpanded =
        simpleSettingsToggle.getAttribute("aria-expanded") === "true";
      simpleSettingsToggle.setAttribute("aria-expanded", String(!isExpanded));
      simpleSettingsPanel?.toggleAttribute("hidden", isExpanded);
    });

    const simpleTabs =
      comparison.querySelectorAll<HTMLButtonElement>("[data-simple-tab]");
    simpleTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        simpleTabs.forEach((item) => {
          const isActive = item === tab;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });
      });
    });

    const simpleStems =
      comparison.querySelectorAll<HTMLButtonElement>("[data-simple-stem]");
    simpleStems.forEach((stem) => {
      stem.addEventListener("click", () => {
        const isSelected = stem.classList.toggle("is-selected");
        stem.setAttribute("aria-pressed", String(isSelected));
      });
    });

    const simpleToggles = comparison.querySelectorAll<HTMLButtonElement>(
      "[data-simple-toggle]",
    );
    simpleToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const isOn = toggle.classList.toggle("is-on");
        toggle.setAttribute("aria-pressed", String(isOn));
      });
    });

    comparison
      .querySelectorAll<HTMLButtonElement>("[data-separate]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          if (status) status.textContent = "Ready for your audio file.";
          window.setTimeout(() => {
            if (status) status.textContent = "";
          }, 2600);
        });
      });
  }
</script>

<style>
  @reference "tailwindcss";
  :root {
    --shadow-custom:
      0px 0px 0px 1px #0000000f, 0px 1px 2px -1px #0000000f,
      0px 2px 4px 0px #0000000a;
    --tw-inset-ring-shadow {
      syntax: "*";
      inherits: false;
      initial-value: 0 0 #0000;
    }
    --tw-inset-shadow {
      syntax: "*";
      inherits: false;
      initial-value: 0 0 #0000;
    }
    --tw-ring-offset-shadow {
      syntax: "*";
      inherits: false;
      initial-value: 0 0 #0000;
    }
    --tw-ring-shadow {
      syntax: "*";
      inherits: false;
      initial-value: 0 0 #0000;
    }
    --tw-shadow: var(--shadow-custom);
  }

  .moises-comparison {
    --pure-black: #000000;
    --aqua: #00dae8;
    --slate: #3f4c59;
    --turquoise: #3ddbb5;
    --pure-white: #ffffff;
    --cream: #e7e4d6;
    --muted: #aeb2b2;
    --line: rgb(255 255 255 / 0.13);
    position: relative;
    isolation: isolate;
    width: min(1320px, calc(100vw - 2rem), 100%);
    max-width: 100%;
    min-width: 0;
    margin: clamp(5rem, 10vw, 9rem) auto 2rem;
    color: var(--pure-white);
    font-family: var(--font-body);
  }

  .moises-comparison,
  .moises-comparison *,
  .moises-comparison *::before,
  .moises-comparison *::after {
    box-sizing: border-box;
  }

  .moises-comparison::before {
    position: absolute;
    z-index: -1;
    top: 17%;
    left: 50%;
    width: min(80vw, 860px);
    height: min(45vw, 480px);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.12);
    content: "";
    filter: blur(50px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .comparison-topline {
    display: grid;
    min-width: 0;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(100%, 1160px);
    margin: 0 auto clamp(2.5rem, 5vw, 4.5rem);
  }

  .play-cue {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 0.45rem;
    color: var(--cream);
    transform: translateX(-2rem) rotate(-4deg);
    position: relative;
  }

  .play-cue .hand {
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    white-space: nowrap;
  }

  .play-cue svg {
    width: 5.2rem;
    height: 3rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    position: relative;
    top: -15px;
    transform: scaleY(-1);

    @media (width >= 42rem) {
      top: 21px;
      transform: scaleY(1);
    }
  }

  .mode-switch {
    box-shadow:
      var(--tw-inset-shadow), var(--tw-inset-ring-shadow),
      var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: clamp(11rem, 17vw, 20rem);
    padding: 8px;
    border-radius: 20px;
    background: var(--cream);
  }

  .mode-switch button {
    min-height: 1.65rem;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: hsl(240, 857.6%, 62.5%);
    cursor: pointer;
    font: 500 1rem var(--font-body);
    transition:
      background 220ms ease,
      color 220ms ease,
      transform 220ms ease;
  }

  .mode-switch button:hover {
    color: var(--pure-black);
  }

  .mode-switch button[aria-pressed="true"] {
    background: hsl(240, 857.6%, 62.5%);
    color: var(--cream);
    box-shadow:
      var(--tw-inset-shadow), var(--tw-inset-ring-shadow),
      var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);
  }

  .mode-switch button:focus-visible,
  .comparison-card button:focus-visible {
    outline: 2px solid var(--aqua);
    outline-offset: 3px;
  }

  .comparison-tag {
    justify-self: end;
    margin: 0;
    color: rgb(255 255 255 / 0.7);
    font: 500 0.66rem/1.7 var(--font-mono);
    letter-spacing: 0.22em;
    text-align: left;
    text-transform: uppercase;
  }

  .comparison-stage {
    display: flex;
    justify-content: center;
    width: 100%;
    min-width: 0;
  }

  .comparison-card {
    border: 1px solid hsl(240, 81.3%, 56.9%);
    background: linear-gradient(
      145deg,
      rgb(20 23 23 / 0.98),
      rgb(0 0 0 / 0.92)
    );
    box-shadow:
      0 1.3rem 3rem rgb(0 0 0 / 0.2),
      0 0 0 1px rgb(0 218 232 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    transition:
      max-width 420ms cubic-bezier(0.19, 1, 0.22, 1),
      border-color 260ms ease,
      box-shadow 260ms ease,
      transform 260ms ease;
  }

  .interface-frame {
    width: 100%;
    max-width: 39rem;
    min-width: 0;
    overflow: hidden;
    border-radius: 1.3rem;
    padding: clamp(1.35rem, 2.5vw, 2rem);
    transform: translateY(-0.35rem);
  }

  .moises-comparison[data-mode="more"] .interface-frame {
    max-width: 50rem;
  }

  .moises-comparison[data-mode="less"] .interface-frame {
    max-width: 39rem;
  }

  .interface-view[hidden],
  [data-mode-copy][hidden],
  [data-more-only][hidden] {
    display: none;
  }

  .interface-view {
    animation: interface-in 320ms cubic-bezier(0.19, 1, 0.22, 1) both;
  }

  @keyframes interface-in {
    from {
      opacity: 0;
      transform: translateY(0.45rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .card-less .card-header {
    gap: 1.1rem;
  }

  .product-mark {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: clamp(3.1rem, 5vw, 4.15rem);
    aspect-ratio: 1;
    border-radius: 0.9rem;
    background: var(--slate);
    color: var(--aqua);
  }

  .product-mark svg {
    width: 67%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.3;
    stroke-linecap: round;
  }

  .card-heading {
    min-width: 0;
  }

  .card-heading h3 {
    overflow: hidden;
    margin: 0;
    color: var(--pure-white);
    font-size: clamp(1rem, 1.55vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-heading p {
    overflow: hidden;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: clamp(0.74rem, 1vw, 0.88rem);
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .version-button,
  .more-button,
  .select-button,
  .settings-heading,
  .advanced-toggle {
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font-family: inherit;
  }

  .version-button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-size: 0.75rem;
  }

  .version-button span,
  .select-button span,
  .settings-heading span,
  .advanced-toggle span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .more-button {
    display: grid;
    gap: 0.2rem;
