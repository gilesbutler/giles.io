---
import { siteConfig } from "~/config/site";
const { gallery } = siteConfig;
// Request a larger image for the lightbox view.
const full = (url: string) => url.replace(/([?&])w=\d+/, "$1w=1600");
---

<section class="section" id="gallery">
  <div class="section-head">
    <p class="kicker">{gallery.kicker}</p>
    <h2>{gallery.heading}</h2>
    {gallery.subtitle && <p class="sub">{gallery.subtitle}</p>}
  </div>

  <div class="gallery-grid">
    {gallery.items.map((g) => (
      <figure class="gal-item">
        <button
          class="frame gal-open"
          type="button"
          data-src={full(g.image)}
          data-cap={g.caption}
          data-label={g.label}
          aria-label={`Open ${g.caption}`}
        >
          <img src={g.image} alt={g.caption} loading="lazy" />
          <span class="handle tl"></span><span class="handle tr"></span><span class="handle bl"></span><span class="handle br"></span>
          <span class="jpg"><b>JPG</b> {g.label}</span>
        </button>
        <figcaption class="cap">{g.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lb-close" type="button" aria-label="Close (Esc)"
      ><svg viewBox="0 0 24 24" fill="none"
        ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg
      ></button
    >
    <button class="lb-prev lb-nav" type="button" aria-label="Previous"
      ><svg viewBox="0 0 24 24" fill="none"
        ><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg
      ></button
    >
    <button class="lb-next lb-nav" type="button" aria-label="Next"
      ><svg viewBox="0 0 24 24" fill="none"
        ><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg
      ></button
    >
    <div class="lb-stage">
      <div class="lb-frame">
        <img class="lb-img" src="" alt="" />
        <span class="lb-jpg"><b>JPG</b> <span class="lb-label"></span></span>
      </div>
      <div class="lb-cap"></div>
      <div class="lb-count"></div>
    </div>
  </div>
</section>

<script>
  (() => {
    const triggers = Array.from(document.querySelectorAll<HTMLElement>(".gal-open"));
    const lb = document.getElementById("lightbox");
    if (!triggers.length || !lb) return;

    const img = lb.querySelector<HTMLImageElement>(".lb-img")!;
    const cap = lb.querySelector<HTMLElement>(".lb-cap")!;
    const label = lb.querySelector<HTMLElement>(".lb-label")!;
    const count = lb.querySelector<HTMLElement>(".lb-count")!;
    const data = triggers.map((t) => ({
      src: t.dataset.src || "",
      cap: t.dataset.cap || "",
      label: t.dataset.label || "",
    }));
    let i = 0;

    const show = (n: number) => {
      i = (n + data.length) % data.length;
      const d = data[i];
      img.src = d.src;
      img.alt = d.cap;
      cap.textContent = d.cap;
      label.textContent = d.label;
      count.textContent =
        String(i + 1).padStart(2, "0") + " / " + String(data.length).padStart(2, "0");
    };
    const open = (n: number) => {
      show(n);
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      lb.classList.remove("open");
      document.body.style.overflow = "";
    };

    triggers.forEach((t, n) => t.addEventListener("click", () => open(n)));
    lb.querySelector(".lb-close")!.addEventListener("click", close);
    lb.querySelector(".lb-prev")!.addEventListener("click", () => show(i - 1));
    lb.querySelector(".lb-next")!.addEventListener("click", () => show(i + 1));
    lb.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === lb || t.classList.contains("lb-stage")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(i - 1);
      else if (e.key === "ArrowRight") show(i + 1);
    });
  })();
</script>
