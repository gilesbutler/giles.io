---
import { siteConfig } from "~/config/site";
const { contact } = siteConfig;
const c = contact.comment;

const heart =
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 20.5C4.6 14 2.6 9.2 5.7 6.2c2.1-2 4.6-1 6.3 1 1.7-2 4.2-3 6.3-1 3.1 3 1.1 7.8-6.3 14.3z"/></svg>';
---

<section class="contact" id="contact">
  <div class="blob" aria-hidden="true"></div>
  <!-- <div class="comment">
    <div class="ph">{c.header}</div>
    <div class="bd">
      <div class="row"><img src={c.avatar} alt="" /><b>{c.name}</b></div>
      <p>{c.body}</p>
      <span class="react">&#9889; {c.reactions}</span>
    </div>
  </div> -->
  <p class="lets" data-reveal>{contact.lets}</p>
  <p class="ctxt" data-reveal>{contact.text}</p>
  <a href={`mailto:${contact.email}`} class="contact-sticker" data-reveal>
    <span class="ico" set:html={heart} />
    <span class="word">{contact.stickerLabel}</span>
    <span class="ico" set:html={heart} />
  </a>
</section>
