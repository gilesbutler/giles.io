---
import './creator-insights.css';
import { summarise } from './creator-insights.js';
const initial = summarise(7, 'plays');
---
<section class="creator-insights" data-creator-insights aria-labelledby="insights-title">
  <header class="ci-header">
    <div><span class="ci-eyebrow">CREATOR INSIGHTS / INTERACTION STUDY</span><h3 id="insights-title">What changed after the release?</h3></div>
    <label class="ci-period">Period<select data-period><option value="7">Last 7 days</option><option value="28">Last 28 days</option></select></label>
  </header>
  <p class="ci-disclosure">Fictional artist and data. No account or SoundCloud connection.</p>
  <div class="ci-toolbar">
    <div class="ci-segment" role="group" aria-label="Metric"><button type="button" data-metric="plays" aria-pressed="true">Plays</button><button type="button" data-metric="listeners" aria-pressed="false">Listeners</button></div>
    <div class="ci-segment" role="group" aria-label="Presentation"><button type="button" data-view="overview" aria-pressed="true">Overview</button><button type="button" data-view="data" aria-pressed="false">Underlying data</button></div>
  </div>
  <div class="ci-summary"><div><span data-metric-label>Plays</span><strong data-total>{new Intl.NumberFormat('en-GB').format(initial.total)}</strong></div><p data-comparison>{Math.round(initial.change ?? 0)}% more than the previous 7 days.</p><span class="ci-period-note" data-period-note>Sample period ends 28 Sep 2026</span></div>
  <div data-overview>
    <figure class="ci-chart"><svg viewBox="0 0 720 250" role="img" aria-labelledby="ci-chart-title ci-chart-desc"><title id="ci-chart-title">Daily plays, last 7 days</title><desc id="ci-chart-desc">Daily fictional plays. Detailed values are available under Underlying data.</desc><g data-grid></g><path class="ci-area" data-area d=""/><path class="ci-line" data-line d=""/><g data-labels></g></svg><figcaption><span data-definition>Plays count repeat listening. They are not unique people.</span><button type="button" data-open-data>Read the values ↓</button></figcaption></figure>
    <div class="ci-interpretation"><span class="ci-eyebrow">WHAT THE NUMBERS CAN TELL US</span><h4 data-insight-title>Listening increased.</h4><p data-insight></p><p class="ci-question"><strong>Next question:</strong> <span data-question></span></p></div>
  </div>
  <div data-data hidden><div class="ci-table-wrap" tabindex="0" role="region" aria-label="Daily sample data"><table><caption data-table-caption>Daily plays, last 7 days</caption><thead><tr><th scope="col">Date</th><th scope="col">Plays</th><th scope="col">Daily unique listeners</th></tr></thead><tbody data-rows></tbody></table></div><p class="ci-data-note">Period listeners are deduplicated across the period, so daily unique listeners must not be summed. This is a synthetic dataset, not an estimate of any artist’s results.</p></div>
  <div class="ci-foot"><span>Definitions and comparisons stay available.</span><button type="button" data-reset>Reset example ↺</button></div>
  <p class="ci-sr" role="status" aria-live="polite" aria-atomic="true" data-announcement></p>
  <noscript><p>This interactive study needs JavaScript. It compares plays and unique listeners, shows the underlying rows and separates observations from suggested questions. All data is fictional.</p></noscript>
</section>
<script>
  import { initialiseInsights } from './creator-insights.js';
  initialiseInsights();
</script>
