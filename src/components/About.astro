---
import { siteConfig } from "~/config/site";
const { about } = siteConfig;
const lead = about.lead;

const skillIcons: Record<string, string> = {
  product:
    '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Ultimate free icons by Streamline - https://creativecommons.org/licenses/by/4.0/ --><path fill="currentColor" d="m11.25 18.3l-7.53-2l3-.78a.75.75 0 0 0 .54-.91a.76.76 0 0 0-.92-.54L.81 15.54a.75.75 0 0 0-.56.79v4.5a.75.75 0 0 0 .59.73l10.41 2.26Zm12.5-2.03a.76.76 0 0 0-.56-.73L17.7 14.1a.76.76 0 0 0-.92.54a.75.75 0 0 0 .54.91l2.78.73l-7.35 2v5.53l10.41-2.26a.75.75 0 0 0 .59-.73zm-7.29-6.94a8.7 8.7 0 0 1-1.13 2.54a4.8 4.8 0 0 1 1 .8a.66.66 0 0 0 1.13-.42a3.73 3.73 0 0 0-1-2.92m-8.92 0a3.73 3.73 0 0 0-1 2.92a.66.66 0 0 0 1.13.42a4.8 4.8 0 0 1 1-.8a8.7 8.7 0 0 1-1.13-2.54M12 0S8.5 1.75 8.5 5.25c0 1.93.58 7 3.5 7s3.5-5.07 3.5-7C15.5 1.75 12 0 12 0m0 6.5a1.38 1.38 0 1 1 1.37-1.38A1.37 1.37 0 0 1 12 6.5m0 6.83a1.4 1.4 0 0 0-1.4 1.4c0 .78.63 2.64 1.4 2.64s1.4-1.86 1.4-2.64a1.4 1.4 0 0 0-1.4-1.4"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M4 10h16M10 4v16" stroke="currentColor" stroke-width="1.8"/></svg>',
  robot:
    '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" d="M10.066 11.066q.434-.433.434-1.066t-.434-1.066T9 8.5t-1.066.434Q7.5 9.367 7.5 10t.434 1.066T9 11.5t1.066-.434m6 0q.434-.433.434-1.066t-.434-1.066T15 8.5t-1.066.434Q13.5 9.367 13.5 10t.434 1.066T15 11.5t1.066-.434M8.5 20v-2.884q0-.27.173-.443t.443-.173H11.5V20zm4 0v-3.5h2.385q.269 0 .442.173t.173.443V20zm-6.884 0q-.672 0-1.144-.472T4 18.385V9q0-2.077 1.462-3.538T9 4h6q2.077 0 3.539 1.462T20 9v9.385q0 .67-.472 1.143q-.472.472-1.143.472H16.5v-2.884q0-.672-.472-1.144t-1.143-.472h-5.77q-.67 0-1.143.472q-.472.472-.472 1.144V20z"/></svg>',
  system:
    '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><!-- Icon from Carbon by IBM - undefined --><path fill="currentColor" d="M4 10h4a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2m0-6h4v4H4zm24 18h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2m0 6h-4v-4h4zm-6.586-15.414L20 14l6 6l6-6l-1.414-1.414L27 16.172V7a2 2 0 0 0-2-2H12v2h13v9.172zM7 15.828l3.586 3.586L12 18l-6-6l-6 6l1.414 1.414L5 15.828V25a2 2 0 0 0 2 2h13v-2H7z"/></svg>',
};
---

<section class="about" id="about">
  <div class="wrap">
    <p class="hand kicker" data-reveal>{about.kicker}</p>
    <h3 class="whatsup selected" data-reveal>
      {about.heading}
      <span class="h tl"></span><span class="h tr"></span><span class="h bl"
      ></span><span class="h br"></span>
    </h3>

    {
      about.workspace[0] && (
        <div
          class="polaroid flt4"
          style="top:170px;left:2%;transform:rotate(-7deg)"
        >
          <>
            <img src={about.workspace[0].image} alt="" />
            <b>{about.workspace[0].caption}</b>
          </>
        </div>
      )
    }
    {
      about.workspace[1] && (
        <div
          class="polaroid flt2"
          style="top:160px;right:2%;transform:rotate(6deg)"
        >
          <>
            <img src={about.workspace[1].image} alt="" />
            <b>{about.workspace[1].caption}</b>
          </>
        </div>
      )
    }

    <p class="lead" data-reveal>
      {lead.partA}
      <img class="inlinephoto" src={lead.photo} alt="" />
      {lead.partB}
      <em>{lead.emphasis}</em>
      {lead.partC}
    </p>

    <div class="skills">
      {
        about.skills.map((sk) => (
          <span class:list={["skill", sk.color]} data-reveal>
            <span
              class="ic"
              set:html={skillIcons[sk.icon] ?? skillIcons.star}
            />
            {sk.label}
          </span>
        ))
      }
    </div>
  </div>
</section>
