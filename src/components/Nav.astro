---
import { siteConfig } from "~/config/site";
const { navigation, name, theme } = siteConfig;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (url: string) => {
  const u = url.replace(/\/+$/, "") || "/";
  return u === "/" ? path === "/" : path === u || path.startsWith(u + "/");
};
---

<header class="nav" id="nav">
  <div class="nav-left">
    <a href="/" class="logo" aria-label={`${name} home`}>{name}<span class="logo-dot">.</span></a>
    {navigation.links.map((l) => (
      <a href={l.url} class:list={["navlink", { active: isActive(l.url) }]}>{l.label}</a>
    ))}
  </div>
  <div class="nav-right">
    {theme.toggle && (
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="ic-moon" viewBox="0 0 24 24" fill="none"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
        >
        <svg class="ic-sun" viewBox="0 0 24 24" fill="none"
          ><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle><path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg
        >
      </button>
    )}
    <a href={navigation.cta.url} class="btn-contact">
      <svg class="heart-ic" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M12 20.5C4.6 14 2.6 9.2 5.7 6.2c2.1-2 4.6-1 6.3 1 1.7-2 4.2-3 6.3-1 3.1 3 1.1 7.8-6.3 14.3z"
        ></path></svg
      >
      {navigation.cta.label}
    </a>
    <button class="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobile navigation">
    {navigation.links.map((l) => (
      <a href={l.url} class:list={["m-link", { active: isActive(l.url) }]}>{l.label}</a>
    ))}
    <a href={navigation.cta.url} class="m-contact">{navigation.cta.label}</a>
  </nav>
</header>
